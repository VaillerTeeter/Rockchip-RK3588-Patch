From cd17e277b88af5d4bdc5b20fd8d3f95d3d936673 Mon Sep 17 00:00:00 2001
From: Vaciller <wyc_19533480830@outlook.com>
Date: Tue, 5 May 2026 16:24:43 +0800
Subject: [PATCH] mmc: dw_mmc: add hardware DRTO calculation for SPL

In SPL build, calculate the data read timeout (DRTO) from the
actual hardware TMOUT and CLKDIV register values rather than
using a fixed size-based estimation.

The hardware-derived timeout is more accurate and avoids spurious
timeouts on slower or variable-clock eMMC configurations.
---
 drivers/mmc/dw_mmc.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/mmc/dw_mmc.c b/drivers/mmc/dw_mmc.c
index 7c9807d59e..eef573bc41 100644
--- a/drivers/mmc/dw_mmc.c
+++ b/drivers/mmc/dw_mmc.c
@@ -163,6 +163,26 @@ static void dwmci_prepare_data(struct dwmci_host *host,
 	dwmci_writel(host, DWMCI_BYTCNT, data->blocksize * data->blocks);
 }
 
+#ifdef CONFIG_SPL_BUILD
+static unsigned int dwmci_get_drto(struct dwmci_host *host,
+                                   const unsigned int size)
+{
+    unsigned int drto_clks, drto_div, drto_ms;
+
+    drto_clks = dwmci_readl(host, DWMCI_TMOUT) >> 8;
+    drto_div = (dwmci_readl(host, DWMCI_CLKDIV) & 0xff) * 2;
+    if (drto_div == 0)
+        drto_div = 1;
+
+    drto_ms = DIV_ROUND_UP_ULL((u64)MSEC_PER_SEC * drto_clks * drto_div,
+                               host->mmc->clock);
+
+	/* add a bit spare time */
+    drto_ms += 10;
+
+    return drto_ms;
+}
+#else
 static unsigned int dwmci_get_drto(struct dwmci_host *host,
 				   const unsigned int size)
 {
@@ -176,6 +196,7 @@ static unsigned int dwmci_get_drto(struct dwmci_host *host,
 
 	return timeout;
 }
+#endif /* CONFIG_SPL_BUILD */
 
 static unsigned int dwmci_get_cto(struct dwmci_host *host)
 {
