+    /**
+     * Install large third-party APKs staged under /system/preinstall before
+     * AMS/systemReady starts home. This keeps the boot animation up while
+     * installing and ensures the apps are already present when the launcher
+     * first appears.
+     *
+     * Idempotent per APK via /data/preinstall_done_<apkName> markers, so a
+     * newly staged APK is installed on the next boot even when the data
+     * partition is not wiped (no global marker blocking later additions).
+     */
+    private void installPreinstalledCarApps() {
+        File dir = new File("/system/preinstall");
+        if (!dir.isDirectory()) {
+            Slog.w(TAG, "/system/preinstall not found, skip preinstall");
+            return;
+        }
+
+        File[] apks = dir.listFiles();
+        if (apks == null || apks.length == 0) {
+            return;
+        }
+
+        for (File apk : apks) {
+            if (!apk.getName().endsWith(".apk")) {
+                continue;
+            }
+
+            File marker = new File("/data/preinstall_done_" + apk.getName());
+            if (marker.exists()) {
+                Slog.i(TAG, "Already installed: " + apk.getName());
+                continue;
+            }
+
+            Slog.i(TAG, "Installing preinstalled car app: " + apk.getName());
+            boolean installed = false;
+            try {
+                Watchdog.getInstance().pauseWatchingCurrentThread("preinstall");
+                java.lang.Process proc = new ProcessBuilder(
+                        "/system/bin/pm", "install", "-r", "-g",
+                        apk.getAbsolutePath())
+                        .redirectErrorStream(true)
+                        .start();
+                java.io.InputStream in = proc.getInputStream();
+                StringBuilder out = new StringBuilder();
+                byte[] buf = new byte[4096];
+                int n;
+                while ((n = in.read(buf)) > 0) {
+                    out.append(new String(buf, 0, n));
+                }
+                in.close();
+                int ret = proc.waitFor();
+                if (ret != 0) {
+                    Slog.e(TAG, "Failed to install " + apk.getName()
+                            + ": " + out.toString().trim());
+                } else {
+                    Slog.i(TAG, "Installed " + apk.getName());
+                    installed = true;
+                }
+            } catch (IOException e) {
+                Slog.e(TAG, "Exception installing " + apk.getName(), e);
+            } catch (InterruptedException e) {
+                Slog.e(TAG, "Interrupted installing " + apk.getName(), e);
+                Thread.currentThread().interrupt();
+            } finally {
+                Watchdog.getInstance().resumeWatchingCurrentThread("preinstall");
+            }
+
+            if (installed) {
+                try {
+                    if (marker.createNewFile()) {
+                        Slog.i(TAG, "Marked installed: " + apk.getName());
+                    }
+                } catch (IOException e) {
+                    Slog.e(TAG, "Failed to write preinstall marker for "
+                            + apk.getName(), e);
+                }
+            }
+        }
+    }
+
