+/**
+ * Full-screen app drawer launched from the navigation bar.
+ *
+ * The background is the platform wallpaper window (ImageWallpaper),
+ * enabled with FLAG_SHOW_WALLPAPER plus a transparent window background.
+ * The wallpaper window is composed below this activity and updates
+ * independently of this activity's visibility, so switching wallpapers
+ * can never show a stale frame here — no wallpaper code is needed at all.
+ */
 public class AppListActivity extends Activity {
 
     private PackageManager mPm;
@@ -26,44 +39,55 @@ public class AppListActivity extends Activity {
     protected void onCreate(Bundle savedInstanceState) {
         requestWindowFeature(Window.FEATURE_NO_TITLE);
         super.onCreate(savedInstanceState);
+
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_SHOW_WALLPAPER);
+        getWindow().setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
+
         setContentView(R.layout.activity_app_list);
 
         mPm = getPackageManager();
 
         GridView grid = findViewById(R.id.app_grid);
-
         List<ResolveInfo> apps = loadApps();
-
