From 8f5554eabd0c7200d23ca1c3ebe122212b156ec9 Mon Sep 17 00:00:00 2001
From: Vaciller <wyc_19533480830@outlook.com>
Date: Mon, 17 Aug 2026 16:35:14 +0800
Subject: [PATCH] feat: render app drawer over wallpaper with transparent
 background

    - AppListActivity: show window over ImageWallpaper via
      FLAG_SHOW_WALLPAPER and transparent background
    - activity_app_list.xml: drop hardcoded #1a1a2e grid background
    - AndroidManifest.xml: set singleTask and stateNotNeeded on
      AppListActivity
    - AppListActivity: hide embedded tile packages from the drawer
      (NeteaseCloudMusic, Ximalaya, Douyin, Bilibili, Emby)

Change-Id: Ia71ffcc0907fdb6affaca72706520f941a876ae4
---
 packages/SystemUI/AndroidManifest.xml         |  3 +
 .../SystemUI/res/layout/activity_app_list.xml |  2 +-
 .../systemui/applist/AppListActivity.java     | 67 +++++++++++++------
 3 files changed, 49 insertions(+), 23 deletions(-)

diff --git a/packages/SystemUI/AndroidManifest.xml b/packages/SystemUI/AndroidManifest.xml
index d17f19c955c0..d8499733a49a 100644
--- a/packages/SystemUI/AndroidManifest.xml
+++ b/packages/SystemUI/AndroidManifest.xml
@@ -1027,6 +1027,9 @@
         <activity
             android:name="com.android.systemui.applist.AppListActivity"
             android:exported="false"
+            android:launchMode="singleTask"
+            android:stateNotNeeded="true"
             android:screenOrientation="landscape" />
+
     </application>
 </manifest>
diff --git a/packages/SystemUI/res/layout/activity_app_list.xml b/packages/SystemUI/res/layout/activity_app_list.xml
index ecfd4a818510..ecbbc6a77f9c 100644
--- a/packages/SystemUI/res/layout/activity_app_list.xml
+++ b/packages/SystemUI/res/layout/activity_app_list.xml
@@ -11,4 +11,4 @@
     android:scrollbars="vertical"
     android:fadeScrollbars="true"
     android:listSelector="@android:color/transparent"
-    android:background="#1a1a2e" />
+    />
diff --git a/packages/SystemUI/src/com/android/systemui/applist/AppListActivity.java b/packages/SystemUI/src/com/android/systemui/applist/AppListActivity.java
