+String8 BootAnimation::pickBootVideoFile() {
+    std::vector<std::string> files;
+
+    // 1. Scan the boot video directory for *.ts entries.
+    DIR* dir = opendir(PRODUCT_BOOTVIDEO_DIR);
+    if (dir != nullptr) {
+        struct dirent* de;
+        while ((de = readdir(dir)) != nullptr) {
+            if (de->d_name[0] == '.') {
+                continue;
+            }
+            std::string name(de->d_name);
+            if (name.size() >= 3 && name.compare(name.size() - 3, 3, ".ts") == 0) {
+                files.push_back(std::string(PRODUCT_BOOTVIDEO_DIR) + "/" + name);
+            }
+        }
+        closedir(dir);
+        std::sort(files.begin(), files.end());
+    }
+
+    // 2. Fall back to the legacy single file when the directory is empty/missing.
+    if (files.empty()) {
+        if (access(PRODUCT_BOOTVIDEO_FILE, R_OK) == 0) {
+            return String8(PRODUCT_BOOTVIDEO_FILE);
+        }
+        return String8();
+    }
+
+    const int n = static_cast<int>(files.size());
+
+    // 3. Restore the persisted shuffled order and current position.
+    char order[PROPERTY_VALUE_MAX];
+    property_get("persist.sys.bootvideo.order", order, "");
+    char posbuf[PROPERTY_VALUE_MAX];
+    property_get("persist.sys.bootvideo.pos", posbuf, "0");
+
+    std::vector<int> idx;
+    char* saveptr = nullptr;
+    char* tok = strtok_r(order, ",", &saveptr);
+    while (tok != nullptr) {
+        idx.push_back(atoi(tok));
+        tok = strtok_r(nullptr, ",", &saveptr);
+    }
+
+    int pos = atoi(posbuf);
+
+    // 4. Validate the persisted order; regenerate a fresh shuffle when invalid.
+    bool valid = (idx.size() == static_cast<size_t>(n));
+    if (valid) {
+        std::vector<int> seen(n, 0);
+        for (int v : idx) {
+            if (v < 0 || v >= n || seen[v]) {
+                valid = false;
+                break;
+            }
+            seen[v] = 1;
+        }
+    }
+    if (!valid || pos < 0 || pos >= n) {
+        idx.resize(n);
+        for (int i = 0; i < n; i++) {
+            idx[i] = i;
+        }
+        srand(static_cast<unsigned int>(systemTime()));
+        for (int i = n - 1; i > 0; i--) {
+            int j = rand() % (i + 1);
+            std::swap(idx[i], idx[j]);
+        }
+        pos = 0;
+        std::string orderStr;
+        for (int i = 0; i < n; i++) {
+            if (i) orderStr += ",";
+            orderStr += std::to_string(idx[i]);
+        }
+        property_set("persist.sys.bootvideo.order", orderStr.c_str());
+    }
+
+    int chosen = idx[pos];
+    int nextPos = (pos + 1) % n;
+    if (nextPos == 0) {
+        // Completed a full cycle → reshuffle for the next round so consecutive
+        // cycles use different orders.
+        srand(static_cast<unsigned int>(systemTime()));
+        for (int i = n - 1; i > 0; i--) {
+            int j = rand() % (i + 1);
+            std::swap(idx[i], idx[j]);
+        }
+        std::string orderStr;
+        for (int i = 0; i < n; i++) {
+            if (i) orderStr += ",";
+            orderStr += std::to_string(idx[i]);
+        }
+        property_set("persist.sys.bootvideo.order", orderStr.c_str());
+    }
+    property_set("persist.sys.bootvideo.pos", std::to_string(nextPos).c_str());
+
+    ALOGD("bootvideo: pick index %d of %d files: %s (nextPos=%d)",
+          chosen, n, files[chosen].c_str(), nextPos);
+    return String8(files[chosen].c_str());
+}
