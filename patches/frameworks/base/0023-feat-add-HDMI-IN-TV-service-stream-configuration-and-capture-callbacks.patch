         }
     }
 
+    public int sendAppPrivateCommand(String action, Bundle data) {
+        synchronized (mLock) {
+            if (mPtr == 0 || null == data) {
+                return ERROR_NO_INIT;
+            }
+            if (nativePrivCmdFromApp(mPtr, action, data) == 1) {
+                return SUCCESS;
+            }
+            return ERROR_UNKNOWN;
+        }
