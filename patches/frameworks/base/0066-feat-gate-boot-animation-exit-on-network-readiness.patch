@@ -3844,6 +3853,131 @@ public class WindowManagerService extends IWindowManager.Stub
         return true;
     }
 
+    /**
+     * Performs the boot animation exit action: sets {@code service.bootanim.exit=1} so the
+     * bootanimation process (which may be playing a boot video) exits gracefully.
+     *
+     * <p>Must be called while holding {@link #mGlobalLock}.
+     */
+    private void performBootAnimExitLocked() {
+        if (mBootAnimExitRequested) {
+            return;
+        }
+        mBootAnimExitRequested = true;
+        Trace.asyncTraceBegin(TRACE_TAG_WINDOW_MANAGER, "Stop bootanim", 0);
+        // stop boot animation
+        // formerly we would just kill the process, but we now ask it to exit so it
+        // can choose where to stop the animation.
+        SystemProperties.set("service.bootanim.exit", "1");
+        mBootAnimationStopped = true;
+    }
+
+    /**
+     * Unregisters the network callback and cancels the timeout runnable.
+     *
+     * <p>Must be called while holding {@link #mGlobalLock}.
+     */
+    private void unregisterBootAnimNetworkCallbackLocked() {
+        if (mBootAnimNetworkCallback != null) {
+            final ConnectivityManager cm = mContext.getSystemService(ConnectivityManager.class);
+            try {
+                cm.unregisterNetworkCallback(mBootAnimNetworkCallback);
+            } catch (IllegalArgumentException e) {
+                // Already unregistered; ignore.
+            }
+            if (mBootAnimTimeoutRunnable != null) {
+                mH.removeCallbacks(mBootAnimTimeoutRunnable);
+                mBootAnimTimeoutRunnable = null;
+            }
+            mBootAnimNetworkCallback = null;
+        }
+    }
+
+    /**
+     * Exits the boot animation immediately if a VALIDATED network is already present; otherwise
+     * registers a {@link ConnectivityManager} callback that exits as soon as connectivity is
+     * established, or after {@code persist.sys.bootanim.net_timeout} seconds (default 120) at the
+     * latest, to avoid leaving the boot animation up forever without a network.
+     *
+     * @return true if the exit action was performed synchronously (network already VALIDATED);
+     *         false if we are now waiting for connectivity.
+     *
+     * <p>Must be called while holding {@link #mGlobalLock}.
+     */
+    private boolean requestBootAnimExitWhenNetworkReadyLocked() {
+        final ConnectivityManager cm = mContext.getSystemService(ConnectivityManager.class);
+        final Network activeNetwork = cm.getActiveNetwork();
+        final NetworkCapabilities caps = activeNetwork != null
+                ? cm.getNetworkCapabilities(activeNetwork) : null;
+        if (caps != null && caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)) {
+            Slog.i(TAG_WM, "performEnableScreen: network available (INTERNET), exit boot anim");
+            performBootAnimExitLocked();
+            return true;
+        }
+
+        if (mBootAnimNetworkCallback == null) {
+            Slog.i(TAG_WM,
+                    "performEnableScreen: no validated network, waiting before exiting boot anim");
+            mBootAnimNetworkCallback = new ConnectivityManager.NetworkCallback() {
+                @Override
+                public void onAvailable(Network network) {
+                    maybeExitBootAnimWhenNetworkReady(network);
+                }
+
+                @Override
+                public void onCapabilitiesChanged(Network network,
+                        NetworkCapabilities networkCapabilities) {
+                    maybeExitBootAnimWhenNetworkReady(network);
+                }
+            };
+            final NetworkRequest request = new NetworkRequest.Builder()
+                    .addCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+                    .build();
+            cm.registerNetworkCallback(request, mBootAnimNetworkCallback, mH);
+
+            final int timeoutSeconds =
+                    SystemProperties.getInt("persist.sys.bootanim.net_timeout", 120);
+            if (timeoutSeconds > 0) {
+                mBootAnimTimeoutRunnable = () -> {
+                    synchronized (mGlobalLock) {
+                        if (!mBootAnimExitRequested) {
+                            Slog.w(TAG_WM,
+                                    "performEnableScreen: boot anim network timeout ("
+                                            + timeoutSeconds + "s), forcing exit");
+                            unregisterBootAnimNetworkCallbackLocked();
+                            performBootAnimExitLocked();
+                            mH.sendEmptyMessage(H.ENABLE_SCREEN);
+                        }
+                    }
+                };
+                mH.postDelayed(mBootAnimTimeoutRunnable, timeoutSeconds * 1000L);
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Called on the {@link #mH} thread from the network callback; exits the boot animation once
+     * the given network is validated and schedules another pass of {@link #performEnableScreen()}.
+     */
+    private void maybeExitBootAnimWhenNetworkReady(Network network) {
+        synchronized (mGlobalLock) {
+            if (mBootAnimExitRequested) {
+                return;
+            }
+            final ConnectivityManager cm = mContext.getSystemService(ConnectivityManager.class);
+            final NetworkCapabilities caps = cm.getNetworkCapabilities(network);
+            if (caps != null && caps.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)) {
+                Slog.i(TAG_WM,
+                        "performEnableScreen: network available (INTERNET), exit boot anim");
+                unregisterBootAnimNetworkCallbackLocked();
+                performBootAnimExitLocked();
+                mH.sendEmptyMessage(H.ENABLE_SCREEN);
+            }
+            // Keep waiting if the network is not yet validated.
+        }
+    }
+
     public void showBootMessage(final CharSequence msg, final boolean always) {
         boolean first = false;
         synchronized (mGlobalLock) {
