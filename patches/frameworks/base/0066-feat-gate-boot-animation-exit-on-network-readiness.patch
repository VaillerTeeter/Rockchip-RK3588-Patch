+++ b/cmds/bootanimation/BootAnimation.cpp
@@ -2077,7 +2077,6 @@ String8 BootAnimation::pickBootVideoFile() {
 
 //add for boot video
 bool BootAnimation::video() {
-    const bool LOOP = false;
     const float CHECK_DELAY = 500*1000;//500ms
     int duration = 0;
     char delay[64];
@@ -2088,6 +2087,9 @@ bool BootAnimation::video() {
     int bootvideo_time = atoi(value);//s
     if(bootvideo_time > 120)
         bootvideo_time = 120;
+    // Loop the video when showtime==-1 (play until the system decides to exit,
+    // e.g. waiting for network); otherwise play once for the configured seconds.
+    const bool LOOP = (bootvideo_time == -1);
 
     //add delaytime set ,default 0.
     property_get("persist.sys.bootvideo.delaytime", value, "0");
