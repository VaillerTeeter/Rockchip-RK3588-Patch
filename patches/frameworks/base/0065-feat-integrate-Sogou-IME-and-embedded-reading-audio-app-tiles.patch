From f9b23860df38d5f1800fbeb3604d0840c082cbf9 Mon Sep 17 00:00:00 2001
From: Vaciller <wyc_19533480830@outlook.com>
Date: Wed, 19 Aug 2026 00:15:56 +0800
Subject: [PATCH] feat: integrate Sogou IME and embedded reading/audio app
 tiles

    - ApkSignatureVerifier.java: relax the minimum signature scheme to JAR
      so the v1-only Sogou prebuilt can be scanned
    - ScanPackageUtils.java: skip the minimum-signature check for Sogou
    - InputMethodManagerService.java: force-enable Sogou and select it as
      the default IME on first boot
    - DecorCaptionView.java: hide the freeform caption bar for the yunting,
      qdreader and fanqie embedded tiles
    - AppListActivity.java: replace the BilibiliHD and Emby entries with the
      yunting, qdreader and fanqie embedded tiles
    - PhoneWindowManager.java: block BACK/HOME for the yunting, qdreader
      and fanqie embedded tiles

Change-Id: I9a248e8990410b6af12f114c062e18359eef987a
---
 .../util/apk/ApkSignatureVerifier.java        | 16 +++++++
 .../internal/widget/DecorCaptionView.java     | 24 ++++++++++
 .../systemui/applist/AppListActivity.java     |  6 ++-
 .../InputMethodManagerService.java            | 23 ++++++++++
 .../android/server/pm/ScanPackageUtils.java   |  6 +++
 .../server/policy/PhoneWindowManager.java     | 44 ++++++++++++++++++-
 6 files changed, 116 insertions(+), 3 deletions(-)

diff --git a/core/java/android/util/apk/ApkSignatureVerifier.java b/core/java/android/util/apk/ApkSignatureVerifier.java
index d2a18dd84313..1b76c98fc502 100644
--- a/core/java/android/util/apk/ApkSignatureVerifier.java
+++ b/core/java/android/util/apk/ApkSignatureVerifier.java
@@ -107,6 +107,14 @@ public class ApkSignatureVerifier {
             String apkPath, @SignatureSchemeVersion int minSignatureSchemeVersion,
             boolean verifyFull) {
 
+        // Headunit workaround: SogouInput is a vendor prebuilt that only carries a
+        // v1 (JAR) signature. Android 13 requires targetSdk >= 30 apps to be v2-signed,
+        // but this IME has no v2/v3 block. Force the minimum scheme to JAR for it so
+        // verification falls through to v1 and the package can be scanned.
+        if (isSogouInputApk(apkPath)) {
+            minSignatureSchemeVersion = SignatureSchemeVersion.JAR;
+        }
+
         if (minSignatureSchemeVersion > SignatureSchemeVersion.SIGNING_BLOCK_V4) {
             // V4 and before are older than the requested minimum signing version
             return input.error(INSTALL_PARSE_FAILED_NO_CERTIFICATES,
@@ -518,6 +526,14 @@ public class ApkSignatureVerifier {
         return SignatureSchemeVersion.JAR;
     }
 
+    /**
+     * Headunit-specific: whether the given APK is the Sogou input method prebuilt.
+     * Identified by the module directory/file name "SogouInput".
+     */
+    private static boolean isSogouInputApk(String apkPath) {
+        return apkPath != null && apkPath.contains("SogouInput");
+    }
+
     /**
      * Result of a successful APK verification operation.
      */
