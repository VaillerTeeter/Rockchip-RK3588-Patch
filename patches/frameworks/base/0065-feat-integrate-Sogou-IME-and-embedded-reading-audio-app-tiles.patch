diff --git a/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java b/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java
index cbbee5dc5755..50feb99a9a3d 100644
--- a/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java
+++ b/services/core/java/com/android/server/inputmethod/InputMethodManagerService.java
@@ -5231,6 +5231,25 @@ public final class InputMethodManagerService extends IInputMethodManager.Stub
         return false;
     }
 
+    /**
+     * Headunit-specific: force-enable the Sogou input method and make it the
+     * default IME on first boot (i.e. when no IME has been selected yet).
+     */
+    @GuardedBy("ImfLock.class")
+    private void forceEnableAndSelectHeadunitSogouImeLocked() {
+        final String sogouPackage = "com.sohu.inputmethod.sogou";
+        for (int i = 0; i < mMethodList.size(); i++) {
+            final InputMethodInfo imi = mMethodList.get(i);
+            if (sogouPackage.equals(imi.getPackageName())) {
+                setInputMethodEnabledLocked(imi.getId(), true);
+                if (TextUtils.isEmpty(mSettings.getSelectedInputMethod())) {
+                    resetSelectedInputMethodAndSubtypeLocked(imi.getId());
+                }
+                return;
+            }
+        }
+    }
+
     static void queryInputMethodServicesInternal(Context context,
             @UserIdInt int userId, ArrayMap<String, List<InputMethodSubtype>> additionalSubtypeMap,
             ArrayMap<String, InputMethodInfo> methodMap, ArrayList<InputMethodInfo> methodList,
@@ -5373,6 +5392,10 @@ public final class InputMethodManagerService extends IInputMethodManager.Stub
             }
         }
 
+        // Headunit: force-enable Sogou and auto-select it as the default IME
+        // on first boot.
+        forceEnableAndSelectHeadunitSogouImeLocked();
+
         final String defaultImiId = mSettings.getSelectedInputMethod();
         if (!TextUtils.isEmpty(defaultImiId)) {
             if (!mMethodMap.containsKey(defaultImiId)) {
diff --git a/services/core/java/com/android/server/pm/ScanPackageUtils.java b/services/core/java/com/android/server/pm/ScanPackageUtils.java
index 93ffcf816c1b..cfb8ae038354 100644
--- a/services/core/java/com/android/server/pm/ScanPackageUtils.java
+++ b/services/core/java/com/android/server/pm/ScanPackageUtils.java
@@ -712,6 +712,12 @@ final class ScanPackageUtils {
 
     public static void assertMinSignatureSchemeIsValid(AndroidPackage pkg,
             @ParsingPackageUtils.ParseFlags int parseFlags) throws PackageManagerException {
+        // Headunit workaround: Sogou input method is a vendor prebuilt that carries only
+        // a v1 (JAR) signature while targeting SDK 33 (>= 30). Skip the minimum-signature
+        // check so it can still be scanned and installed as a system IME.
+        if ("com.sohu.inputmethod.sogou".equals(pkg.getPackageName())) {
+            return;
+        }
         int minSignatureSchemeVersion =
                 ApkSignatureVerifier.getMinimumSignatureSchemeVersionForTargetSdk(
                         pkg.getTargetSdkVersion());
diff --git a/services/core/java/com/android/server/policy/PhoneWindowManager.java b/services/core/java/com/android/server/policy/PhoneWindowManager.java
index 339eb6f74150..06175e2230a5 100644
