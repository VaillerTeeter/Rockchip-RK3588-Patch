@@ -955,6 +955,45 @@ public class PhoneWindowManager implements WindowManagerPolicy {
                 && info.windowTitle.contains("com.ss.android.ugc.aweme");
     }
 
+    /**
+     * Returns true if the focused window belongs to Yunting.
+     * Used to block key events from reaching the embedded audio tile.
+     */
+    private boolean isYuntingFocused(IBinder focusedToken) {
+        com.android.internal.policy.KeyInterceptionInfo info = mWindowManagerInternal
+                .getKeyInterceptionInfoFromToken(focusedToken);
+        if (info == null)
+            return false;
+        return info.windowTitle != null
+                && info.windowTitle.contains("com.shinyv.cnr");
+    }
+
+    /**
+     * Returns true if the focused window belongs to Qdreader.
+     * Used to block key events from reaching the embedded reading tile.
+     */
+    private boolean isQdreaderFocused(IBinder focusedToken) {
+        com.android.internal.policy.KeyInterceptionInfo info = mWindowManagerInternal
+                .getKeyInterceptionInfoFromToken(focusedToken);
+        if (info == null)
+            return false;
+        return info.windowTitle != null
+                && info.windowTitle.contains("com.qidian.QDReader");
+    }
+
+    /**
+     * Returns true if the focused window belongs to Fanqie.
+     * Used to block key events from reaching the embedded reading tile.
+     */
+    private boolean isFanqieFocused(IBinder focusedToken) {
+        com.android.internal.policy.KeyInterceptionInfo info = mWindowManagerInternal
+                .getKeyInterceptionInfoFromToken(focusedToken);
+        if (info == null)
+            return false;
+        return info.windowTitle != null
+                && info.windowTitle.contains("com.dragon.read");
+    }
+
     // returns true if the key was handled and should not be passed to the user
     private boolean backKeyPress() {
         mLogger.count("key_back_press", 1);
@@ -2916,7 +2955,10 @@ public class PhoneWindowManager implements WindowManagerPolicy {
         if (focusedToken != null && (isAmapAutoFocused(focusedToken)
                 || isNeteaseCloudMusicFocused(focusedToken)
                 || isXimalayaFocused(focusedToken)
-                || isDouyinFocused(focusedToken))) {
+                || isDouyinFocused(focusedToken)
+                || isYuntingFocused(focusedToken)
+                || isQdreaderFocused(focusedToken)
+                || isFanqieFocused(focusedToken))) {
             if (event.getKeyCode() == KeyEvent.KEYCODE_BACK
                     || event.getKeyCode() == KeyEvent.KEYCODE_HOME) {
                 return -1;
