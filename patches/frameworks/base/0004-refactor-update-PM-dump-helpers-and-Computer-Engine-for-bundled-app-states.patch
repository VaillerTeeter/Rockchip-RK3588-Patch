     public static final int DUMP_PER_UID_READ_TIMEOUTS = 1 << 28;
     public static final int DUMP_SNAPSHOT_STATISTICS = 1 << 29;
     public static final int DUMP_PROTECTED_BROADCASTS = 1 << 30;
