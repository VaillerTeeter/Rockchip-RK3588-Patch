From 59f2c149c7997c22086e7ded411f2b78d5aee352 Mon Sep 17 00:00:00 2001
From: Vaciller <wyc_19533480830@outlook.com>
Date: Fri, 10 Jul 2026 15:27:14 +0800
Subject: [PATCH] feat: add Rockchip graphics support (BBQ naming, Mali-450
 fence, GPU_DATA_BUFFER bypass, NO_AFBC usage)

Change-Id: Icc3c709c513a391729546431c9f782a5df1cc816

diff --git a/libs/gui/SurfaceControl.cpp b/libs/gui/SurfaceControl.cpp
index 654fb336fe..a8168e3902 100644
--- a/libs/gui/SurfaceControl.cpp
+++ b/libs/gui/SurfaceControl.cpp
@@ -138,9 +138,11 @@ sp<Surface> SurfaceControl::generateSurfaceLocked()
     uint32_t ignore;
     auto flags = mCreateFlags & (ISurfaceComposerClient::eCursorWindow |
                                  ISurfaceComposerClient::eOpaque);
-    mBbqChild = mClient->createSurface(String8("bbq-wrapper"), 0, 0, mFormat,
+    //-----------------------rk code----------
+    mBbqChild = mClient->createSurface(String8(mDefaultBbqChildName.c_str()), 0, 0, mFormat,
                                        flags, mHandle, {}, &ignore);
-    mBbq = sp<BLASTBufferQueue>::make("bbq-adapter", mBbqChild, mWidth, mHeight, mFormat);
+    mBbq = sp<BLASTBufferQueue>::make(mDefaultBbqName, mBbqChild, mWidth, mHeight, mFormat);
+    //----------------------------------------
 
     // This surface is always consumed by SurfaceFlinger, so the
     // producerControlledByApp value doesn't matter; using false.
@@ -149,6 +151,16 @@ sp<Surface> SurfaceControl::generateSurfaceLocked()
     return mSurfaceData;
 }
 
+//-----------------------rk code----------
+void SurfaceControl::setDefaultBbqName(std::string defaultName) {
+    mDefaultBbqName = defaultName;
+}
+
+void SurfaceControl::setDefaultBbqChildName(std::string defaultName) {
+    mDefaultBbqChildName = defaultName;
+}
+//----------------------------------------
+
 sp<Surface> SurfaceControl::getSurface()
 {
     Mutex::Autolock _l(mLock);
