From 7692387635b6c0516e7c4553890fb70804cdb208 Mon Sep 17 00:00:00 2001
From: Vaciller <wyc_19533480830@outlook.com>
Date: Sat, 11 Jul 2026 00:59:56 +0800
Subject: [PATCH 6/6] feat: restart vendor.tv-input-1-0 on zygote restart for
 Rockchip TV input

Change-Id: I5777a1f07042f35251dd183bd976f7a25622c03b
---
 rootdir/init.zygote32.rc    | 1 +
 rootdir/init.zygote64.rc    | 1 +
 rootdir/init.zygote64_32.rc | 1 +
 3 files changed, 3 insertions(+)

diff --git a/rootdir/init.zygote32.rc b/rootdir/init.zygote32.rc
index 2f0ec8a17..9fd0b31cb 100644
--- a/rootdir/init.zygote32.rc
+++ b/rootdir/init.zygote32.rc
@@ -16,5 +16,6 @@ service zygote /system/bin/app_process -Xzygote /system/bin --zygote --start-sys
     onrestart restart media.tuner
     onrestart restart netd
     onrestart restart wificond
+    onrestart restart vendor.tv-input-1-0
     task_profiles ProcessCapacityHigh
     critical window=${zygote.critical_window.minute:-off} target=zygote-fatal
diff --git a/rootdir/init.zygote64.rc b/rootdir/init.zygote64.rc
index 805267d1d..6611c2748 100644
--- a/rootdir/init.zygote64.rc
+++ b/rootdir/init.zygote64.rc
@@ -16,5 +16,6 @@ service zygote /system/bin/app_process64 -Xzygote /system/bin --zygote --start-s
     onrestart restart media.tuner
     onrestart restart netd
     onrestart restart wificond
+    onrestart restart vendor.tv-input-1-0
     task_profiles ProcessCapacityHigh
     critical window=${zygote.critical_window.minute:-off} target=zygote-fatal
diff --git a/rootdir/init.zygote64_32.rc b/rootdir/init.zygote64_32.rc
index efb30d664..c95d2a009 100644
--- a/rootdir/init.zygote64_32.rc
+++ b/rootdir/init.zygote64_32.rc
@@ -13,6 +13,7 @@ service zygote /system/bin/app_process64 -Xzygote /system/bin --zygote --start-s
     onrestart restart media.tuner
     onrestart restart netd
     onrestart restart wificond
+    onrestart restart vendor.tv-input-1-0
     task_profiles ProcessCapacityHigh MaxPerformance
     critical window=${zygote.critical_window.minute:-off} target=zygote-fatal
 
-- 
2.53.0

