From b34a8ef6e0a0aba56ba1a0f199435e24f8b1703f Mon Sep 17 00:00:00 2001
From: Vaciller <wyc_19533480830@outlook.com>
Date: Sat, 11 Jul 2026 00:57:40 +0800
Subject: [PATCH 5/6] feat: add USB NCM gadget configfs support for Rockchip
 ethernet over USB

Change-Id: I2193508bfe3cf34f0fc93f70310b2af01c1a57db
---
 rootdir/init.usb.configfs.rc | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/rootdir/init.usb.configfs.rc b/rootdir/init.usb.configfs.rc
index 3a33c94d3..1e423ddb3 100644
--- a/rootdir/init.usb.configfs.rc
+++ b/rootdir/init.usb.configfs.rc
@@ -9,6 +9,7 @@ on property:sys.usb.config=none && property:sys.usb.configfs=1
     rm /config/usb_gadget/g1/configs/b.1/f2
     rm /config/usb_gadget/g1/configs/b.1/f3
     rmdir /config/usb_gadget/g1/functions/rndis.gs4
+    rmdir /config/usb_gadget/g1/functions/ncm.gs7
     setprop sys.usb.state ${sys.usb.config}
 
 on property:init.svc.adbd=stopped
@@ -138,3 +139,21 @@ on property:sys.usb.ffs.ready=1 && property:sys.usb.config=rndis,adb && property
     symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
     write /config/usb_gadget/g1/UDC ${sys.usb.controller}
     setprop sys.usb.state ${sys.usb.config}
+
+on property:sys.usb.config=ncm && property:sys.usb.configfs=1
+    mkdir /config/usb_gadget/g1/functions/ncm.gs7
+    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "ncm"
+    symlink /config/usb_gadget/g1/functions/ncm.gs7 /config/usb_gadget/g1/configs/b.1/f1
+    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
+    setprop sys.usb.state ${sys.usb.config}
+
+on property:sys.usb.config=ncm,adb && property:sys.usb.configfs=1
+    start adbd
+
+on property:sys.usb.ffs.ready=1 && property:sys.usb.config=ncm,adb && property:sys.usb.configfs=1
+    mkdir /config/usb_gadget/g1/functions/ncm.gs7
+    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "ncm_adb"
+    symlink /config/usb_gadget/g1/functions/ncm.gs7 /config/usb_gadget/g1/configs/b.1/f1
+    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
+    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
+    setprop sys.usb.state ${sys.usb.config}
-- 
2.53.0

