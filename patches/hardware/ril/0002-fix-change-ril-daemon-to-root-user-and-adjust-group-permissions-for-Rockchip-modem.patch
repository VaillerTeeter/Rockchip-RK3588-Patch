From 6ba71d5ced16499359af9be19022342e709259ac Mon Sep 17 00:00:00 2001
From: Vaciller <wyc_19533480830@outlook.com>
Date: Fri, 10 Jul 2026 22:46:22 +0800
Subject: [PATCH] fix: change ril-daemon to root user and adjust group
 permissions for Rockchip modem

Change-Id: Ia1c7a4962014f1247530bedaadd3d71aad97ac4b
---
 rild/rild.rc | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/rild/rild.rc b/rild/rild.rc
index f6beb54..249e7ad 100644
--- a/rild/rild.rc
+++ b/rild/rild.rc
@@ -1,5 +1,5 @@
-service vendor.ril-daemon /vendor/bin/hw/rild
+service ril-daemon /vendor/bin/hw/rild
     class main
-    user radio
-    group radio cache inet misc audio log readproc wakelock
+    user root
+    group radio cache inet misc audio sdcard_rw log
     capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
-- 
2.53.0

