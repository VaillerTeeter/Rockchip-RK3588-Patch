+                    rmc->utc_time[f_len] = '\0';
+                }
+                break;
+            case RMC_FIELD_STATUS:
+                if (f_len > 0) {
+                    rmc->status = f[0];
+                }
+                break;
+            case RMC_FIELD_LATITUDE:
+                rmc->latitude = nmea_to_degrees(f, f_len);
+                break;
+            case RMC_FIELD_NS_INDICATOR:
+                if (f_len > 0) {
+                    rmc->ns = f[0];
+                }
+                break;
+            case RMC_FIELD_LONGITUDE:
+                rmc->longitude = nmea_to_degrees(f, f_len);
+                break;
+            case RMC_FIELD_EW_INDICATOR:
+                if (f_len > 0) {
+                    rmc->ew = f[0];
+                }
+                break;
+            case RMC_FIELD_SPEED:
+                rmc->speed_knots = (float)field_to_double(f, f_len);
+                break;
+            case RMC_FIELD_COURSE:
+                rmc->course_deg = (float)field_to_double(f, f_len);
+                break;
+            case RMC_FIELD_DATE:
+                if (f_len < sizeof(rmc->date)) {
+                    memcpy(rmc->date, f, f_len);
+                    rmc->date[f_len] = '\0';
+                }
+                break;
+            case RMC_FIELD_MAG_VAR:
+                if (f_len < sizeof(rmc->mag_var)) {
+                    memcpy(rmc->mag_var, f, f_len);
+                    rmc->mag_var[f_len] = '\0';
+                }
+                break;
+            case RMC_FIELD_MAG_VAR_EW:
+                if (f_len > 0) {
+                    rmc->mag_var_ew = f[0];
+                }
+                break;
+            case RMC_FIELD_MODE:
+                if (f_len > 0) {
+                    rmc->mode = f[0];
+                }
+                break;
+            case RMC_FIELD_NAV_STATUS:
+                if (f_len > 0) {
+                    rmc->nav_status = f[0];
+                }
+                break;
+            default:
+                break;
+        }
+    }
+
+    /* 南纬取负、西经取负 */
+    if (rmc->ns == 'S') {
+        rmc->latitude = -rmc->latitude;
+    }
+    if (rmc->ew == 'W') {
+        rmc->longitude = -rmc->longitude;
+    }
+    nmea_checksum(line, rmc->checksum);
+}
+
+/* 解析 $GNGLL / $GPGLL：按 GLLField 逐个取字段填入 GLL 结构体。
+ * 除语句标识 TALKER_ID(0) 外，字段 1~7 全部存储，不做差别。 */
