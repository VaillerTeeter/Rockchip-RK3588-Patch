+/* ====================================================================================================================
+ * $GNGGA —— 定位解（Global Positioning System Fix Data）
+ *
+ * 实测数据示例（静置状态）：
+ *   $GNGGA,072655.000,3200.892919,N,11850.257262,E,1,34,0.68,6.512,M,5.286,M,,*49
+ *
+ *   Index  Value         GGAField                   GGA            Meaning
+ *   ------------------------------------------------------------------------------------------------------------------
+ *   0      $GNGGA        GGA_FIELD_TALKER_ID                      语句标识
+ *   1      072655.000    GGA_FIELD_UTC_TIME         utc_time      UTC 时间 hhmmss.sss
+ *   2      3200.892919   GGA_FIELD_LATITUDE         latitude      纬度 ddmm.mmmm
+ *   3      N             GGA_FIELD_NS_INDICATOR     ns            南北半球：N=北 S=南
+ *   4      11850.257262  GGA_FIELD_LONGITUDE        longitude     经度 dddmm.mmmm
+ *   5      E             GGA_FIELD_EW_INDICATOR     ew            东西半球：E=东 W=西
+ *   6      1             GGA_FIELD_FIX_QUALITY      fix_quality   定位质量：0=无效 1=单点 4=RTK固定 5=RTK浮点 9=惯导
+ *   7      34            GGA_FIELD_SATELLITES_USED  sats_used     参与解算卫星数
+ *   8      0.68          GGA_FIELD_HDOP             hdop          HDOP 水平精度因子
+ *   9      6.512         GGA_FIELD_ALTITUDE         altitude      海拔（米，单位见字段 10）
+ *   10     M             GGA_FIELD_ALT_UNIT         alt_unit      海拔单位：M=米
+ *   11     5.286         GGA_FIELD_GEOID_SEP        geoid_sep     大地水准面差距（单位见字段 12）
+ *   12     M             GGA_FIELD_GEOID_UNIT       geoid_unit    大地水准面差距单位：M=米
+ *   13                   GGA_FIELD_DIFF_AGE         diff_age      差分修正数据龄期（无差分时为空）
+ *   14     *49           GGA_FIELD_DIFF_STATION     diff_station  差分基准站 ID（无差分时省略，此段为校验和）
+ * ================================================================================================================= */
+
+enum GGAField : int {
+    GGA_FIELD_TALKER_ID       = 0,
+    GGA_FIELD_UTC_TIME        = 1,
+    GGA_FIELD_LATITUDE        = 2,
+    GGA_FIELD_NS_INDICATOR    = 3,
+    GGA_FIELD_LONGITUDE       = 4,
+    GGA_FIELD_EW_INDICATOR    = 5,
+    GGA_FIELD_FIX_QUALITY     = 6,
+    GGA_FIELD_SATELLITES_USED = 7,
+    GGA_FIELD_HDOP            = 8,
+    GGA_FIELD_ALTITUDE        = 9,
+    GGA_FIELD_ALT_UNIT        = 10,
+    GGA_FIELD_GEOID_SEP       = 11,
+    GGA_FIELD_GEOID_UNIT      = 12,
+    GGA_FIELD_DIFF_AGE        = 13,
+    GGA_FIELD_DIFF_STATION    = 14,
+    GGA_FIELD_COUNT           = 15,
+};
+
+struct GGA {
+    char   utc_time[16];
+    double latitude;
+    char   ns;
+    double longitude;
+    char   ew;
+    int    fix_quality;
+    int    sats_used;
+    float  hdop;
+    float  altitude;
+    char   alt_unit;
+    float  geoid_sep;
+    char   geoid_unit;
+    char   diff_age[16];
+    char   diff_station[16];
+    char   checksum[3];  /* *hh 校验和（2 位十六进制 + '\0'） */
+};
+
+/* ====================================================================================================================
+ * $GNRMC —— 推荐最小定位信息（Recommended Minimum Specific GNSS Data）
+ *
+ * 实测数据示例（静置状态）：
+ *   $GNRMC,072655.000,A,3200.892919,N,11850.257262,E,0.010,024.96,200826,,,A,V*37
+ *
+ *   Index  Value         RMCField                RMC          Meaning
+ *   ------------------------------------------------------------------------------------------------------------------
+ *   0      $GNRMC        RMC_FIELD_TALKER_ID                  语句标识
+ *   1      072655.000    RMC_FIELD_UTC_TIME      utc_time     UTC 时间 hhmmss.sss
+ *   2      A             RMC_FIELD_STATUS        status       数据有效：A=有效 V=无效
+ *   3      3200.892919   RMC_FIELD_LATITUDE      latitude     纬度 ddmm.mmmm
+ *   4      N             RMC_FIELD_NS_INDICATOR  ns           南北半球：N=北 S=南
+ *   5      11850.257262  RMC_FIELD_LONGITUDE     longitude    经度 dddmm.mmmm
+ *   6      E             RMC_FIELD_EW_INDICATOR  ew           东西半球：E=东 W=西
+ *   7      0.010         RMC_FIELD_SPEED         speed_knots  地面速度（节）
+ *   8      024.96        RMC_FIELD_COURSE        course_deg   地面航向（度，真北基准）
+ *   9      200826        RMC_FIELD_DATE          date         日期 ddmmyy
+ *   10                   RMC_FIELD_MAG_VAR       mag_var      磁偏角（度）
+ *   11                   RMC_FIELD_MAG_VAR_EW    mag_var_ew   磁偏角方向：E=东 W=西
+ *   12     A             RMC_FIELD_MODE          mode         定位模式：A=自主 D=差分 E=推算 F=浮点RTK M=手动 N=无定位 R=RTK
+ *   13     V             RMC_FIELD_NAV_STATUS    nav_status   导航状态：S=安全 C=注意 U=不安全 V=无效
+ * ================================================================================================================= */
+
+enum RMCField : int {
+    RMC_FIELD_TALKER_ID    = 0,
+    RMC_FIELD_UTC_TIME     = 1,
+    RMC_FIELD_STATUS       = 2,
+    RMC_FIELD_LATITUDE     = 3,
+    RMC_FIELD_NS_INDICATOR = 4,
+    RMC_FIELD_LONGITUDE    = 5,
+    RMC_FIELD_EW_INDICATOR = 6,
+    RMC_FIELD_SPEED        = 7,
+    RMC_FIELD_COURSE       = 8,
+    RMC_FIELD_DATE         = 9,
+    RMC_FIELD_MAG_VAR      = 10,
+    RMC_FIELD_MAG_VAR_EW   = 11,
+    RMC_FIELD_MODE         = 12,
+    RMC_FIELD_NAV_STATUS   = 13,
+    RMC_FIELD_COUNT        = 14,
+};
+
+struct RMC {
+    char   utc_time[16];
+    char   status;
+    double latitude;
+    char   ns;
+    double longitude;
+    char   ew;
+    float  speed_knots;
+    float  course_deg;
+    char   date[7];
+    char   mag_var[16];
+    char   mag_var_ew;
+    char   mode;
+    char   nav_status;
+    char   checksum[3];  /* *hh 校验和（2 位十六进制 + '\0'） */
+};
+
+/* ====================================================================================================================
+ * $GNGLL —— 地理定位信息（Geographic Position - Latitude/Longitude）
+ *
+ * 实测数据示例（静置状态）：
+ *   $GNGLL,3200.892919,N,11850.257262,E,072655.000,A,A*4C
+ *
+ *   Index  Value         GLLField                GLL        Meaning
+ *   ------------------------------------------------------------------------------------------------------------------
+ *   0      $GNGLL        GLL_FIELD_TALKER_ID                语句标识
+ *   1      3200.892919   GLL_FIELD_LATITUDE      latitude   纬度 ddmm.mmmm
+ *   2      N             GLL_FIELD_NS_INDICATOR  ns         南北半球：N=北 S=南
+ *   3      11850.257262  GLL_FIELD_LONGITUDE     longitude  经度 dddmm.mmmm
+ *   4      E             GLL_FIELD_EW_INDICATOR  ew         东西半球：E=东 W=西
+ *   5      072655.000    GLL_FIELD_UTC_TIME      utc_time   UTC 时间 hhmmss.sss
+ *   6      A             GLL_FIELD_STATUS        status     数据状态：A=有效 V=无效
+ *   7      A             GLL_FIELD_MODE          mode       定位模式：A=自主 D=差分 E=推算 F=浮点RTK M=手动 N=无定位 R=RTK
+ * ================================================================================================================= */
+
+enum GLLField : int {
+    GLL_FIELD_TALKER_ID    = 0,
+    GLL_FIELD_LATITUDE     = 1,
+    GLL_FIELD_NS_INDICATOR = 2,
+    GLL_FIELD_LONGITUDE    = 3,
+    GLL_FIELD_EW_INDICATOR = 4,
+    GLL_FIELD_UTC_TIME     = 5,
+    GLL_FIELD_STATUS       = 6,
+    GLL_FIELD_MODE         = 7,
+    GLL_FIELD_COUNT        = 8,
+};
+
+struct GLL {
+    double latitude;
+    char   ns;
+    double longitude;
+    char   ew;
+    char   utc_time[16];
+    char   status;
+    char   mode;
+    char   checksum[3];  /* *hh 校验和（2 位十六进制 + '\0'） */
+};
+
+/* ====================================================================================================================
+ * $GNVTG —— 对地航向与速度（Course Over Ground and Ground Speed）
+ *
+ * 实测数据示例（静置状态）：
+ *   $GNVTG,024.96,T,,M,0.011,N,0.020,K,A*28
+ *
+ *   Index  Value   VTGField                  VTG               Meaning
+ *   ------------------------------------------------------------------------------------------------------------------
+ *   0      $GNVTG  VTG_FIELD_TALKER_ID                         语句标识
+ *   1      024.96  VTG_FIELD_COURSE_TRUE     course_true       真北航向（度）
+ *   2      T       VTG_FIELD_COURSE_TRUE_UNIT course_true_unit 真北单位：T=真北
+ *   3               VTG_FIELD_COURSE_MAG     course_mag        磁北航向（度，可空）
+ *   4      M       VTG_FIELD_COURSE_MAG_UNIT course_mag_unit   磁北单位：M=磁北
+ *   5      0.011   VTG_FIELD_SPEED_KNOTS     speed_knots       对地速度（节）
+ *   6      N       VTG_FIELD_SPEED_KNOTS_UNIT speed_knots_unit 速度单位：N=节
+ *   7      0.020   VTG_FIELD_SPEED_KMH       speed_kmh         对地速度（km/h）
+ *   8      K       VTG_FIELD_SPEED_KMH_UNIT  speed_kmh_unit    速度单位：K=km/h
+ *   9      A       VTG_FIELD_MODE            mode              定位模式：A=自主 D=差分 E=推算 F=浮点RTK M=手动 N=无定位 R=RTK
+ * ================================================================================================================= */
+
+enum VTGField : int {
+    VTG_FIELD_TALKER_ID        = 0,
+    VTG_FIELD_COURSE_TRUE      = 1,
+    VTG_FIELD_COURSE_TRUE_UNIT = 2,
+    VTG_FIELD_COURSE_MAG       = 3,
+    VTG_FIELD_COURSE_MAG_UNIT  = 4,
+    VTG_FIELD_SPEED_KNOTS      = 5,
+    VTG_FIELD_SPEED_KNOTS_UNIT = 6,
+    VTG_FIELD_SPEED_KMH        = 7,
+    VTG_FIELD_SPEED_KMH_UNIT   = 8,
+    VTG_FIELD_MODE             = 9,
+    VTG_FIELD_COUNT            = 10,
+};
+
+struct VTG {
+    float course_true;
+    char  course_true_unit;
+    char  course_mag[16];
+    char  course_mag_unit;
+    float speed_knots;
+    char  speed_knots_unit;
+    float speed_kmh;
+    char  speed_kmh_unit;
+    char  mode;
+    char  checksum[3];  /* *hh 校验和（2 位十六进制 + '\0'） */
+};
+
+/* ====================================================================================================================
+ * $GNGSA —— DOP 与参与解算卫星（GNSS DOP and Active Satellites）
+ *
+ * 实测数据示例（静置状态，各星座各一条，此处取北斗句作代表）：
+ *   $GNGSA,A,3,01,04,06,07,10,14,19,21,22,36,39,26,1.20,0.68,0.99,4*09
+ *
+ *   Index  Value   GSAField             GSA            Meaning
+ *   ------------------------------------------------------------------------------------------------------------------
+ *   0      $GNGSA  GSA_FIELD_TALKER_ID                      语句标识
+ *   1      A       GSA_FIELD_MODE1      mode1      模式1：M=手动 A=自动
+ *   2      3       GSA_FIELD_MODE2      mode2      模式2：1=无定位 2=2D 3=3D
+ *   3      01      GSA_FIELD_PRN_1      prn[0]     参与解算卫星号 1
+ *   4      04      GSA_FIELD_PRN_2      prn[1]     参与解算卫星号 2
+ *   5      06      GSA_FIELD_PRN_3      prn[2]     参与解算卫星号 3
+ *   6      07      GSA_FIELD_PRN_4      prn[3]     参与解算卫星号 4
+ *   7      10      GSA_FIELD_PRN_5      prn[4]     参与解算卫星号 5
+ *   8      14      GSA_FIELD_PRN_6      prn[5]     参与解算卫星号 6
+ *   9      19      GSA_FIELD_PRN_7      prn[6]     参与解算卫星号 7
+ *   10     21      GSA_FIELD_PRN_8      prn[7]     参与解算卫星号 8
+ *   11     22      GSA_FIELD_PRN_9      prn[8]     参与解算卫星号 9
+ *   12     36      GSA_FIELD_PRN_10     prn[9]     参与解算卫星号 10
+ *   13     39      GSA_FIELD_PRN_11     prn[10]    参与解算卫星号 11
+ *   14     26      GSA_FIELD_PRN_12     prn[11]    参与解算卫星号 12
+ *   15     1.20    GSA_FIELD_PDOP       pdop       PDOP 位置精度因子
+ *   16     0.68    GSA_FIELD_HDOP       hdop       HDOP 水平精度因子
+ *   17     0.99    GSA_FIELD_VDOP       vdop       VDOP 垂直精度因子
+ *   18     4       GSA_FIELD_SYSTEM_ID  system_id  系统ID：1=GPS 2=GLONASS 3=Galileo 4=BeiDou 5=QZSS
+ * ================================================================================================================= */
+
+enum GSAField : int {
+    GSA_FIELD_TALKER_ID = 0,
+    GSA_FIELD_MODE1     = 1,
+    GSA_FIELD_MODE2     = 2,
+    GSA_FIELD_PRN_1     = 3,
+    GSA_FIELD_PRN_2     = 4,
+    GSA_FIELD_PRN_3     = 5,
+    GSA_FIELD_PRN_4     = 6,
+    GSA_FIELD_PRN_5     = 7,
+    GSA_FIELD_PRN_6     = 8,
+    GSA_FIELD_PRN_7     = 9,
+    GSA_FIELD_PRN_8     = 10,
+    GSA_FIELD_PRN_9     = 11,
+    GSA_FIELD_PRN_10    = 12,
+    GSA_FIELD_PRN_11    = 13,
+    GSA_FIELD_PRN_12    = 14,
+    GSA_FIELD_PDOP      = 15,
+    GSA_FIELD_HDOP      = 16,
+    GSA_FIELD_VDOP      = 17,
+    GSA_FIELD_SYSTEM_ID = 18,
+    GSA_FIELD_COUNT     = 19,
+};
+
+struct GSA {
+    char  mode1;
+    int   mode2;
+    int   prn[12];
+    float pdop;
+    float hdop;
+    float vdop;
+    int   system_id;
+    char  checksum[3];  /* *hh 校验和（2 位十六进制 + '\0'） */
+};
+
+/* ====================================================================================================================
+ * $GPGSV / $GLGSV / $GAGSV / $GBGSV / $GQGSV —— 可见卫星（GNSS Satellites in View）
+ *
+ * 实测数据示例（静置状态，取 GPS 首帧 4 颗完整；每帧 1~4 颗不等，且个别
+ * 卫星的仰角/方位角可为空，NMEA 4.1 句尾另有信号 ID 字段）：
+ *   $GPGSV,2,1,08,02,07,298,23,10,75,210,26,12,38,062,16,23,43,163,35,1*63
+ *
+ *   Index  Value   GSVField                GSV                  Meaning
+ *   ------------------------------------------------------------------------------------------------------------------
+ *   0      $GPGSV  GSV_FIELD_TALKER_ID                              语句标识（GP=GPS GL=GLONASS GA=Galileo GB=BeiDou GQ=QZSS）
+ *   1      2       GSV_FIELD_TOTAL_MSG     total_messages           总帧数
+ *   2      1       GSV_FIELD_MSG_NUM       message_number           当前帧号，从 1 起
+ *   3      08      GSV_FIELD_SATS_IN_VIEW  satellites_in_view       本星座可见卫星总数
+ *   4      02      GSV_FIELD_SAT1_SVID     satellites[0].svid       卫星1 卫星号
+ *   5      07      GSV_FIELD_SAT1_ELEV     satellites[0].elevation  卫星1 仰角（度）
+ *   6      298     GSV_FIELD_SAT1_AZIM     satellites[0].azimuth    卫星1 方位角（度）
+ *   7      23      GSV_FIELD_SAT1_CNO      satellites[0].cno        卫星1 载噪比（dB-Hz）
+ *   8      10      GSV_FIELD_SAT2_SVID     satellites[1].svid       卫星2 卫星号
+ *   9      75      GSV_FIELD_SAT2_ELEV     satellites[1].elevation  卫星2 仰角（度）
+ *   10     210     GSV_FIELD_SAT2_AZIM     satellites[1].azimuth    卫星2 方位角（度）
+ *   11     26      GSV_FIELD_SAT2_CNO      satellites[1].cno        卫星2 载噪比（dB-Hz）
+ *   12     12      GSV_FIELD_SAT3_SVID     satellites[2].svid       卫星3 卫星号
+ *   13     38      GSV_FIELD_SAT3_ELEV     satellites[2].elevation  卫星3 仰角（度）
+ *   14     062     GSV_FIELD_SAT3_AZIM     satellites[2].azimuth    卫星3 方位角（度）
+ *   15     16      GSV_FIELD_SAT3_CNO      satellites[2].cno        卫星3 载噪比（dB-Hz）
+ *   16     23      GSV_FIELD_SAT4_SVID     satellites[3].svid       卫星4 卫星号
+ *   17     43      GSV_FIELD_SAT4_ELEV     satellites[3].elevation  卫星4 仰角（度）
+ *   18     163     GSV_FIELD_SAT4_AZIM     satellites[3].azimuth    卫星4 方位角（度）
+ *   19     35      GSV_FIELD_SAT4_CNO      satellites[3].cno        卫星4 载噪比（dB-Hz）
+ *   20     1       GSV_FIELD_SIGNAL_ID     signal_id                信号ID（NMEA 4.1 尾部新增）
+ * ================================================================================================================= */
+
+enum GSVField : int {
+    GSV_FIELD_TALKER_ID    = 0,
+    GSV_FIELD_TOTAL_MSG    = 1,
+    GSV_FIELD_MSG_NUM      = 2,
+    GSV_FIELD_SATS_IN_VIEW = 3,
+    GSV_FIELD_SAT1_SVID    = 4,
+    GSV_FIELD_SAT1_ELEV    = 5,
+    GSV_FIELD_SAT1_AZIM    = 6,
+    GSV_FIELD_SAT1_CNO     = 7,
+    GSV_FIELD_SAT2_SVID    = 8,
+    GSV_FIELD_SAT2_ELEV    = 9,
+    GSV_FIELD_SAT2_AZIM    = 10,
+    GSV_FIELD_SAT2_CNO     = 11,
+    GSV_FIELD_SAT3_SVID    = 12,
+    GSV_FIELD_SAT3_ELEV    = 13,
+    GSV_FIELD_SAT3_AZIM    = 14,
+    GSV_FIELD_SAT3_CNO     = 15,
+    GSV_FIELD_SAT4_SVID    = 16,
+    GSV_FIELD_SAT4_ELEV    = 17,
+    GSV_FIELD_SAT4_AZIM    = 18,
+    GSV_FIELD_SAT4_CNO     = 19,
+    GSV_FIELD_SIGNAL_ID    = 20,
+    GSV_FIELD_COUNT        = 21,
+};
+
+struct GSVSatellite {
+    int svid;
+    int elevation;
+    int azimuth;
+    int cno;
+};
+
+struct GSV {
+    char          talker[3];
+    int           total_messages;
+    int           message_number;
+    int           satellites_in_view;
+    int           signal_id;
+    GSVSatellite  satellites[4];
+    int           satellite_count;
+    char          checksum[3];  /* *hh 校验和（2 位十六进制 + '\0'） */
+};
+
+/* ====================================================================================================================
+ * NMEA 语句类型标识
+ *
+ * 用于按语句类型分发解析。语句标识取 $ 符号后第 2~4 字节（如 "$GNGGA" 的 "GGA"），
+ * 与 talker 前缀（GN/GP/GL/GA/GB/GQ）无关，同一类型各 talker 复用同一标识。
+ * ================================================================================================================= */
+
+constexpr char NMEA_TAG_GGA[] = "GGA"; /* 定位解 */
+constexpr char NMEA_TAG_RMC[] = "RMC"; /* 推荐最小定位信息 */
+constexpr char NMEA_TAG_GLL[] = "GLL"; /* 地理定位信息 */
+constexpr char NMEA_TAG_VTG[] = "VTG"; /* 对地航向与速度 */
+constexpr char NMEA_TAG_GSA[] = "GSA"; /* DOP 与参与解算卫星 */
+constexpr char NMEA_TAG_GSV[] = "GSV"; /* 可见卫星 */
+
+/* ====================================================================================================================
+ * 星座枚举
+ *
+ * 与 GSV 语句的 talker 前缀对应（详见 GSV 字段表），供卫星上报时区分星座使用。
+ * ================================================================================================================= */
+
+enum Constellation : int {
+    CONSTELLATION_GPS = 0,     /* talker: GP */
+    CONSTELLATION_GLONASS = 1, /* talker: GL */
+    CONSTELLATION_GALILEO = 2, /* talker: GA */
+    CONSTELLATION_BEIDOU = 3,  /* talker: GB */
+    CONSTELLATION_QZSS = 4,    /* talker: GQ */
+    CONSTELLATION_UNKNOWN = 5, /* 其它/未知 */
+};
+
+/* ====================================================================================================================
+ * 串口配置常量
+ *
+ * 设备：Quectel LC29H GNSS 模组经 USB 转串口工具挂在 RK3588 上，默认枚举为
+ *       /dev/ttyUSB0，115200 8N1 原始模式（raw），阻塞读 + 100ms 超时。
+ * ================================================================================================================= */
+
+/* ---- 设备 ---- */
+
+/* 默认串口设备节点（USB 转串口，RK 板上枚举为 ttyUSB0） */
+constexpr char SERIAL_DEV_DEFAULT[] = "/dev/ttyUSB0";
+
+/* 波特率（termios 常量）：LC29H 默认 NMEA 输出 115200 */
+constexpr speed_t SERIAL_BAUD_RATE = B115200;
+
+/* 数据位：CS8 = 8 数据位 */
+constexpr tcflag_t SERIAL_DATA_BITS = CS8;
+
+/* 校验位：0 = 不使能校验（8N1 中的 N 无校验） */
+constexpr tcflag_t SERIAL_PARITY_NONE = 0;
+
+/* 停止位：0 = 1 停止位（8N1 中的 1；CSTOPB 置位才是 2 停止位） */
+constexpr tcflag_t SERIAL_STOP_BITS_1 = 0;
+
+/* 控制模式标志（c_cflag）：8N1 组合 + CLOCAL（忽略 Modem 控制线，
+ * 防 open 卡死）+ CREAD（使能接收）；不置 CRTSCTS 关闭硬件流控 */
+constexpr tcflag_t SERIAL_C_CFLAG = CLOCAL | CREAD | CS8;
+
+/* ---- 读超时（阻塞读语义）---- */
+
+/* VMIN=0：有数据立即返回；VTIME=1：无数据最多等 100ms（单位 0.1s）。
+ * 保证 stop() 后读线程能在 100ms 内退出阻塞的 read()。 */
+constexpr cc_t SERIAL_VMIN = 0;
+constexpr cc_t SERIAL_VTIME = 1;
+
+/* ---- 打开标志 ---- */
+
+/* O_NONBLOCK 仅用于打开阶段：避免对端无载波（DCD）时 open 阻塞。
+ * 配好 termios 后需 fcntl(F_SETFL, 0) 清掉该标志，恢复阻塞读。 */
+constexpr int SERIAL_OPEN_FLAGS = O_RDONLY | O_NOCTTY | O_NONBLOCK;
+
+/* ---- 读取缓冲 / 打开重试 ---- */
+
+/* 单次 read() 块缓冲 */
+constexpr int SERIAL_READ_BUF = 1024;
+
+/* NMEA 行缓冲（按 '\n' 切行时累积用，单行最长约 77 字节） */
+constexpr int NMEA_LINE_MAX = 1024;
+
+/* 打开失败后分段重试：20 × 100ms = 2s，兼容 USB 晚枚举 / 热插拔；
+ * 分段睡眠保证 stop() 能及时生效。 */
+constexpr int SERIAL_OPEN_RETRIES = 20;
+constexpr int SERIAL_RETRY_STEP_US = 100000;
+
+/* ====================================================================================================================
+ * 日志配置
+ * ================================================================================================================= */
+
+/* 运行时日志级别（编译期定死，不使用系统属性）：
+ * 0 = 仅生命周期 / 错误
+ * 1 = + 每周期解析摘要
+ * 2 = + 原始 NMEA 语句逐条转储 */
+constexpr int SERIAL_VERBOSE_LEVEL = 2;
+
+/* ====================================================================================================================
+ * 上报回调
+ *
+ * 串口读线程解析出语句后，通过以下回调把结构化数据传给上层（Gnss HAL）。
+ * 未设置的回调（std::function 为空）不调用；GLL/VTG 结构化上报用不到，故不设回调。
+ * ================================================================================================================= */
+
+struct NmeaCallbacks {
+    std::function<void(const GGA&)> onGga;  /* $GNGGA / $GPGGA 定位解 */
+    std::function<void(const RMC&)> onRmc;  /* $GNRMC / $GPRMC 推荐最小定位信息 */
+    std::function<void(const GSA&)> onGsa;  /* $GNGSA / $GPGSA DOP 与参与解算卫星 */
+    std::function<void(const GSV&)> onGsv;  /* $GPGSV 等 可见卫星 */
+    std::function<void()> onIdle;           /* 串口 100ms 无数据，视为一包 NMEA 结束 */
+};
+
+/* ====================================================================================================================
+ * 函数
+ * ================================================================================================================= */
+
+/* 打开串口。
+ * 返回：成功 fd(>=0)；失败 -1（errno 为具体错误）。 */
+int nmea_serial_open(const char* dev);
+
+/* 关闭串口（fd 无效时直接返回）。 */
+void nmea_serial_close(int fd);
+
+/* 单次阻塞读取原始字节（不切行、不解析）。
+ * 返回：>0 实际字节数；0 超时无数据；-1 出错（errno=EINTR 可重试）。 */
+int nmea_serial_read(int fd, char* buf, int len);
+
+/* 循环读取串口：按 '\n' 切出完整一行，解析后通过 cb 回调结构化数据，
+ * 并打印到 logcat（验证数据链路用）。阻塞运行，直到出错返回 -1。 */
+int nmea_serial_read_loop(int fd, const NmeaCallbacks& cb);
+}  // namespace nmea
+}  // namespace V2_1
+}  // namespace gnss
+}  // namespace hardware
+}  // namespace android
+
+#endif  // ANDROID_HARDWARE_GNSS_V2_1_NMEA_SERIAL_READER_H_
