+/*
+ * NmeaSerialReader.cpp
+ *
+ * 串口读写实现：打开 / 关闭 / 读取原始字节。
+ */
+
+#define LOG_TAG "android.hardware.gnss@2.1-service"
+// #define GNSS_DEBUG   true
+#define GNSS_DEBUG_2 true
+
+#include "NmeaSerialReader.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <termios.h>
+#include <unistd.h>
+
+#include <log/log.h>
+
+namespace android {
+namespace hardware {
+namespace gnss {
+namespace V2_1 {
+namespace nmea {
+
+/* 行切分状态：累积半行，遇 '\n' 切出完整一行 */
+char g_line_buf[NMEA_LINE_MAX];
+size_t g_line_len = 0;
+
+int nmea_serial_open(const char* dev) {
+    if (dev == nullptr) {
+        ALOGE("%s: null device path", __func__);
+        return -1;
+    }
+
+    /* O_NONBLOCK 仅用于打开阶段：避免对端无载波（DCD）时 open 阻塞。 */
+    int fd = open(dev, SERIAL_OPEN_FLAGS);
+    if (fd < 0) {
+        ALOGE("%s: open %s failed: %s", __func__, dev, strerror(errno));
+        return -1;
+    }
+
+    struct termios tio;
+    memset(&tio, 0, sizeof(tio));
+
+    /* 波特率：115200 */
+    if (cfsetispeed(&tio, SERIAL_BAUD_RATE) != 0 ||
+        cfsetospeed(&tio, SERIAL_BAUD_RATE) != 0) {
+        ALOGE("%s: cfset speed failed: %s", __func__, strerror(errno));
+        close(fd);
+        return -1;
+    }
+
+    /* 8N1 raw：8 数据位、无校验、1 停止位，忽略 Modem 控制线，使能接收 */
+    tio.c_cflag = SERIAL_C_CFLAG;
+
+    /* 关闭软件/硬件流控与回显，原始字节流 */
+    tio.c_iflag = 0;
+    tio.c_oflag = 0;
+    tio.c_lflag = 0;
+
+    /* 阻塞读语义：有数据立即返回；无数据最多等 100ms */
+    tio.c_cc[VMIN] = SERIAL_VMIN;
+    tio.c_cc[VTIME] = SERIAL_VTIME;
+
+    tcflush(fd, TCIOFLUSH);
+    if (tcsetattr(fd, TCSANOW, &tio) != 0) {
+        ALOGE("%s: tcsetattr failed: %s", __func__, strerror(errno));
+        close(fd);
+        return -1;
+    }
+
+    /* 打开阶段结束，清掉 O_NONBLOCK 恢复阻塞读，使 VTIME 生效 */
+    if (fcntl(fd, F_SETFL, 0) != 0) {
+        ALOGE("%s: fcntl(F_SETFL) failed: %s", __func__, strerror(errno));
+        close(fd);
+        return -1;
+    }
+
+    ALOGI("%s: opened %s", __func__, dev);
+    return fd;
+}
+
+void nmea_serial_close(int fd) {
+    if (fd >= 0) {
+        close(fd);
+    }
+}
+
+/* 单次阻塞读取原始字节（不切行、不解析）。 */
+int nmea_serial_read(int fd, char* buf, int len) {
+    if (fd < 0 || buf == nullptr || len <= 0) {
+        ALOGE("%s: invalid param (fd=%d buf=%p len=%d)", __func__, fd,
+              static_cast<const void*>(buf), len);
+        return -1;
+    }
+
+    /* 阻塞 read：有数据立即返回，无数据最多等 100ms（open 时配置）。
+     * EINTR（信号打断）原样返回，由调用方决定是否重试。 */
+    return read(fd, buf, len);
+}
+#ifdef GNSS_DEBUG
+/* 供 %c 打印：空字符字段返回 '-'，避免向日志写入 '\0' 截断后续输出
+ * （一点信号都没、字段全空时也不会出问题）。 */
+static char log_char(char c) {
+    return c == '\0' ? '-' : c;
+}
+#endif
+/* 把一块字节累积进行缓冲，遇 '\n' 切一行给 on_line（去掉行尾 '\r'）
+ * 文件内部辅助函数，仅被 nmea_serial_read_loop 调用。 */
+static void line_feed(const char* data, int len,
+                      const std::function<void(const char* line, int len)>& on_line) {
+    if (data == nullptr || len <= 0) {
+        ALOGE("%s: invalid param (data=%p len=%d)", __func__,
+              static_cast<const void*>(data), len);
+        return;
+    }
+
+    for (int i = 0; i < len; ++i) {
+        const char c = data[i];
+        if (c == '\n') {
+            size_t line_len = g_line_len;
+            /* NMEA 行以 \r\n 结尾，去掉 '\r' */
+            if (line_len > 0 && g_line_buf[line_len - 1] == '\r') {
+                --line_len;
+            }
+            if (line_len > 0 && on_line != nullptr) {
+                on_line(g_line_buf, static_cast<int>(line_len));
+            }
+            g_line_len = 0;
+        } else if (g_line_len < sizeof(g_line_buf) - 1) {
+            g_line_buf[g_line_len++] = c;
+        } else {
+            /* 缓冲满仍未到换行：丢弃该行，防异常数据 */
+            ALOGW("%s: line buffer overflow, dropping line (len=%zu)", __func__, g_line_len);
+            g_line_len = 0;
+        }
+    }
+}
+
+/* 取第 idx 个逗号分隔字段，返回其起始指针与长度；字段不存在返回 nullptr。
+ * 例：line="$GNGGA,072655.000,3200.892919,N,..."，idx=1 → "072655.000"。 */
+static const char* field_at(const char* line, int idx, size_t* out_len) {
+    int cur = 0;
+    const char* p = line;
+    while (cur < idx) {
+        if (*p == '\0') {
+            return nullptr;
+        }
+        if (*p++ == ',') {
+            cur++;
+        }
+    }
+    const char* start = p;
+    /* ',' 结束一个字段；'*' 是 NMEA 校验和分隔符，也视为字段结束，
+     * 避免把 '*hh'（如 "*4C"）误并入最后一个字段。 */
+    while (*p != '\0' && *p != ',' && *p != '*') {
+        p++;
+    }
+    *out_len = (size_t)(p - start);
+    return start;
+}
+
+/* 提取 *hh 校验和到 out[3]（含结尾 '\0'）；无 '*' 或缺两位时填空串。 */
+static void nmea_checksum(const char* line, char out[3]) {
+    out[0] = out[1] = out[2] = '\0';
+    if (line == nullptr) {
+        return;
+    }
+    const char* p = strchr(line, '*');
+    if (p == nullptr || p[1] == '\0') {
+        return;
+    }
+    out[0] = p[1];
+    if (p[2] != '\0' && p[2] != '\r' && p[2] != '\n') {
+        out[1] = p[2];
+    }
+}
+
+/* 字段转整数（字段为空返回 0）。 */
+static int field_to_int(const char* s, size_t len) {
+    if (s == nullptr || len == 0) {
+        return 0;  /* 空字段合法（NMEA 允许），不视为错误 */
+    }
+    if (len >= 32) {
+        ALOGW("%s: field too long (%zu), skipping", __func__, len);
+        return 0;
+    }
+    char tmp[32];
+    memcpy(tmp, s, len);
+    tmp[len] = '\0';
+    return atoi(tmp);
+}
+
+/* 字段转浮点数（字段为空返回 0.0）。 */
+static double field_to_double(const char* s, size_t len) {
+    if (s == nullptr || len == 0) {
+        return 0.0;  /* 空字段合法（NMEA 允许），不视为错误 */
+    }
+    if (len >= 32) {
+        ALOGW("%s: field too long (%zu), skipping", __func__, len);
+        return 0.0;
+    }
+    char tmp[32];
+    memcpy(tmp, s, len);
+    tmp[len] = '\0';
+    return strtod(tmp, nullptr);
+}
+
+/* ddmm.mmmm → 十进制度。例 "3200.892919" → 32.01488198... */
+static double nmea_to_degrees(const char* s, size_t len) {
+    double raw = field_to_double(s, len);
+    double deg = (int)(raw / 100.0);
+    double min = raw - deg * 100.0;
+    return deg + min / 60.0;
+}
+
+/* 解析 $GNGGA / $GPGGA：按 GGAField 逐个取字段填入 GGA 结构体。
+ * 除语句标识 TALKER_ID(0) 外，字段 1~14 全部存储，不做差别。 */
+static void parse_gga(const char* line, int len, GGA* gga) {
+    if (line == nullptr || gga == nullptr) {
+        ALOGE("%s: null param (line=%p gga=%p)", __func__,
+              static_cast<const void*>(line), static_cast<void*>(gga));
+        return;
+    }
+    (void)len;
+    memset(gga, 0, sizeof(GGA));
+
+    for (int idx = GGA_FIELD_UTC_TIME; idx <= GGA_FIELD_DIFF_STATION; ++idx) {
+        size_t f_len = 0;
+        const char* f = field_at(line, idx, &f_len);
+        if (f == nullptr) {
+            /* 字段不足（畸形/截断语句） */
+            ALOGW("%s: field %d missing, truncated line: %.*s", __func__, idx, (int)strlen(line),
+                  line);
+            break;
+        }
+
+        switch (idx) {
+            case GGA_FIELD_UTC_TIME:
+                if (f_len < sizeof(gga->utc_time)) {
+                    memcpy(gga->utc_time, f, f_len);
+                    gga->utc_time[f_len] = '\0';
+                }
+                break;
+            case GGA_FIELD_LATITUDE:
+                gga->latitude = nmea_to_degrees(f, f_len);
+                break;
+            case GGA_FIELD_NS_INDICATOR:
+                if (f_len > 0) {
+                    gga->ns = f[0];
+                }
+                break;
+            case GGA_FIELD_LONGITUDE:
+                gga->longitude = nmea_to_degrees(f, f_len);
+                break;
+            case GGA_FIELD_EW_INDICATOR:
+                if (f_len > 0) {
+                    gga->ew = f[0];
+                }
+                break;
+            case GGA_FIELD_FIX_QUALITY:
+                gga->fix_quality = field_to_int(f, f_len);
+                break;
+            case GGA_FIELD_SATELLITES_USED:
+                gga->sats_used = field_to_int(f, f_len);
+                break;
+            case GGA_FIELD_HDOP:
+                gga->hdop = (float)field_to_double(f, f_len);
+                break;
+            case GGA_FIELD_ALTITUDE:
+                gga->altitude = (float)field_to_double(f, f_len);
+                break;
+            case GGA_FIELD_ALT_UNIT:
+                if (f_len > 0) {
+                    gga->alt_unit = f[0];
+                }
+                break;
+            case GGA_FIELD_GEOID_SEP:
+                gga->geoid_sep = (float)field_to_double(f, f_len);
+                break;
+            case GGA_FIELD_GEOID_UNIT:
+                if (f_len > 0) {
+                    gga->geoid_unit = f[0];
+                }
+                break;
+            case GGA_FIELD_DIFF_AGE:
+                if (f_len < sizeof(gga->diff_age)) {
+                    memcpy(gga->diff_age, f, f_len);
+                    gga->diff_age[f_len] = '\0';
+                }
+                break;
+            case GGA_FIELD_DIFF_STATION:
+                if (f_len < sizeof(gga->diff_station)) {
+                    memcpy(gga->diff_station, f, f_len);
+                    gga->diff_station[f_len] = '\0';
+                }
+                break;
+            default:
+                break;
+        }
+    }
+
+    /* 南纬取负、西经取负 */
+    if (gga->ns == 'S') {
+        gga->latitude = -gga->latitude;
+    }
+    if (gga->ew == 'W') {
+        gga->longitude = -gga->longitude;
+    }
+    nmea_checksum(line, gga->checksum);
+}
+
+/* 解析 $GNRMC / $GPRMC：按 RMCField 逐个取字段填入 RMC 结构体。
+ * 除语句标识 TALKER_ID(0) 外，字段 1~13 全部存储，不做差别。 */
+static void parse_rmc(const char* line, int len, RMC* rmc) {
