+/* 解析 $GNGSA / $GPGSA：按 GSAField 逐个取字段填入 GSA 结构体。
+ * 除语句标识 TALKER_ID(0) 外，字段 1~18 全部存储，不做差别。
+ * 注：每个星座各一条 GSA（system_id 区分 1~5），字段 3~14 为空时照存 0。 */
+static void parse_gsa(const char* line, int len, GSA* gsa) {
+    if (line == nullptr || gsa == nullptr) {
+        ALOGE("%s: null param (line=%p gsa=%p)", __func__,
+              static_cast<const void*>(line), static_cast<void*>(gsa));
+        return;
+    }
+    (void)len;
+    memset(gsa, 0, sizeof(GSA));
+
+    for (int idx = GSA_FIELD_MODE1; idx <= GSA_FIELD_SYSTEM_ID; ++idx) {
+        size_t f_len = 0;
+        const char* f = field_at(line, idx, &f_len);
+        if (f == nullptr) {
+            /* 字段不足（畸形/截断语句） */
+            ALOGW("%s: field %d missing, truncated line: %.*s", __func__, idx,
+                  (int)strlen(line), line);
+            break;
+        }
+
+        switch (idx) {
+            case GSA_FIELD_MODE1:
+                if (f_len > 0) {
+                    gsa->mode1 = f[0];
+                }
+                break;
+            case GSA_FIELD_MODE2:
+                gsa->mode2 = field_to_int(f, f_len);
+                break;
+            case GSA_FIELD_PRN_1:
+            case GSA_FIELD_PRN_2:
+            case GSA_FIELD_PRN_3:
+            case GSA_FIELD_PRN_4:
+            case GSA_FIELD_PRN_5:
+            case GSA_FIELD_PRN_6:
+            case GSA_FIELD_PRN_7:
+            case GSA_FIELD_PRN_8:
+            case GSA_FIELD_PRN_9:
+            case GSA_FIELD_PRN_10:
+            case GSA_FIELD_PRN_11:
+            case GSA_FIELD_PRN_12:
+                gsa->prn[idx - GSA_FIELD_PRN_1] = field_to_int(f, f_len);
+                break;
+            case GSA_FIELD_PDOP:
+                gsa->pdop = (float)field_to_double(f, f_len);
+                break;
+            case GSA_FIELD_HDOP:
+                gsa->hdop = (float)field_to_double(f, f_len);
+                break;
+            case GSA_FIELD_VDOP:
+                gsa->vdop = (float)field_to_double(f, f_len);
+                break;
+            case GSA_FIELD_SYSTEM_ID:
+                gsa->system_id = field_to_int(f, f_len);
+                break;
+            default:
+                break;
+        }
+    }
+    nmea_checksum(line, gsa->checksum);
+}
+
+/* 解析 $GPGSV/$GLGSV/$GAGSV/$GBGSV/$GQGSV：按 GSVField 逐段取字段填入 GSV 结构体。
+ * - talker（line[1..2]）记录来源星座（GP/GL/GA/GB/GQ）；
+ * - 固定头：总帧数/当前帧号/本星座可见卫星数；
+ * - 卫星块：一帧最多 4 颗，每颗 svid/elevation/azimuth/cno 4 字段；
+ * - 尾部（NMEA 4.1）：信号 ID。 */
+static void parse_gsv(const char* line, int len, GSV* gsv) {
+    if (line == nullptr || gsv == nullptr) {
+        ALOGE("%s: null param (line=%p gsv=%p)", __func__,
+              static_cast<const void*>(line), static_cast<void*>(gsv));
+        return;
+    }
+    (void)len;
+    memset(gsv, 0, sizeof(GSV));
+
+    /* talker：line[1..2]，如 "$GPGSV" → "GP" */
+    if (strlen(line) >= 3) {
+        gsv->talker[0] = line[1];
+        gsv->talker[1] = line[2];
+        gsv->talker[2] = '\0';
+    }
+
+    size_t f_len = 0;
+
+    /* 固定头：总帧数 / 当前帧号 / 本星座可见卫星数 */
+    {
+        const char* f = field_at(line, GSV_FIELD_TOTAL_MSG, &f_len);
+        gsv->total_messages = field_to_int(f, f_len);
+        f = field_at(line, GSV_FIELD_MSG_NUM, &f_len);
+        gsv->message_number = field_to_int(f, f_len);
+        f = field_at(line, GSV_FIELD_SATS_IN_VIEW, &f_len);
+        gsv->satellites_in_view = field_to_int(f, f_len);
+    }
+
+    /* 卫星块：本帧卫星数 = 总可见 - 前几帧已报，每帧最多 4 颗；
+     * 不足 4 颗时只读实际颗数，避免把信号 ID 误当卫星。 */
+    int remaining = gsv->satellites_in_view - (gsv->message_number - 1) * 4;
+    int sats_this_frame = remaining > 4 ? 4 : remaining;
+    if (sats_this_frame < 0) {
+        sats_this_frame = 0;
+    }
+
+    for (int i = 0; i < sats_this_frame; ++i) {
+        const int base = GSV_FIELD_SAT1_SVID + i * 4;
+        gsv->satellites[i].svid = field_to_int(field_at(line, base, &f_len), f_len);
+        gsv->satellites[i].elevation = field_to_int(field_at(line, base + 1, &f_len), f_len);
+        gsv->satellites[i].azimuth = field_to_int(field_at(line, base + 2, &f_len), f_len);
+        gsv->satellites[i].cno = field_to_int(field_at(line, base + 3, &f_len), f_len);
+    }
+    gsv->satellite_count = sats_this_frame;
+
+    /* 尾部信号 ID（NMEA 4.1）：紧跟本帧全部卫星块之后 */
+    {
+        const int signal_idx = GSV_FIELD_SAT1_SVID + sats_this_frame * 4;
+        const char* f = field_at(line, signal_idx, &f_len);
+        gsv->signal_id = field_to_int(f, f_len);
+    }
+    nmea_checksum(line, gsv->checksum);
+}
+
+/* 语句分发：识别语句类型并调用对应解析、打印、回调。
+ * 整行只判断一次 '$' 与长度，else-if 命中即返回，避免多条 strncmp 重复扫描。 */
+static void handle_line(const char* line, int len, const NmeaCallbacks& cb) {
+    if (line == nullptr || len < 6 || line[0] != '$') {
+        return;
+    }
+
+    /* 语句标识位于 "$" + 2 字符 talker（GN/GP/GL/GA/GB/GQ）之后 */
+    const char* tag = line + 3;
+
+    if (strncmp(tag, NMEA_TAG_GGA, 3) == 0) {
+        GGA gga;
+        parse_gga(line, len, &gga);
+        if (cb.onGga) {
+            cb.onGga(gga);
+        }
+#ifdef GNSS_DEBUG
+        /* 打印 GGA 解析出的全部 14 个字段（与 GGAField 1~14 一一对应，中文便于调试） */
+        ALOGD("[GGA] 时间=%s 纬度=%.7f 北南=%c 经度=%.7f 东西=%c "
+              "定位质量=%d 卫星数=%d HDOP=%.2f "
+              "海拔=%.2f 海拔单位=%c 水准面差=%.2f 水准面单位=%c "
+              "差分龄期=%s 差分站ID=%s 校验和=*%s",
+              gga.utc_time, gga.latitude, log_char(gga.ns),
+              gga.longitude, log_char(gga.ew),
+              gga.fix_quality, gga.sats_used, gga.hdop,
+              gga.altitude, log_char(gga.alt_unit),
+              gga.geoid_sep, log_char(gga.geoid_unit),
+              gga.diff_age, gga.diff_station, gga.checksum);
+#endif
+    } else if (strncmp(tag, NMEA_TAG_RMC, 3) == 0) {
+        RMC rmc;
+        parse_rmc(line, len, &rmc);
+        if (cb.onRmc) {
+            cb.onRmc(rmc);
+        }
+#ifdef GNSS_DEBUG
+        /* 打印 RMC 解析出的全部 13 个字段（中文，便于调试） */
+        ALOGD("[RMC] 时间=%s 有效=%c 纬度=%.7f 北南=%c 经度=%.7f 东西=%c "
+              "速度=%.3f节 航向=%.2f度 日期=%s 磁偏角=%s 磁偏角方向=%c "
+              "模式=%c 导航状态=%c 校验和=*%s",
+              rmc.utc_time, log_char(rmc.status),
+              rmc.latitude, log_char(rmc.ns), rmc.longitude, log_char(rmc.ew),
+              rmc.speed_knots, rmc.course_deg, rmc.date,
+              rmc.mag_var, log_char(rmc.mag_var_ew),
+              log_char(rmc.mode), log_char(rmc.nav_status), rmc.checksum);
+#endif
+    } else if (strncmp(tag, NMEA_TAG_GLL, 3) == 0) {
+        GLL gll;
+        parse_gll(line, len, &gll);
+#ifdef GNSS_DEBUG
+        /* 打印 GLL 解析出的全部 7 个字段（中文，便于调试） */
+        ALOGD("[GLL] 纬度=%.7f 北南=%c 经度=%.7f 东西=%c 时间=%s 状态=%c 模式=%c 校验和=*%s",
+              gll.latitude, log_char(gll.ns),
+              gll.longitude, log_char(gll.ew),
+              gll.utc_time, log_char(gll.status), log_char(gll.mode), gll.checksum);
+#endif
+    } else if (strncmp(tag, NMEA_TAG_VTG, 3) == 0) {
+        VTG vtg;
+        parse_vtg(line, len, &vtg);
+#ifdef GNSS_DEBUG
+        /* 打印 VTG 解析出的全部 9 个字段（中文，便于调试） */
+        ALOGD("[VTG] 真北航向=%.2f 真北单位=%c 磁北航向=%s 磁北单位=%c "
+              "速度(节)=%.3f 单位=%c 速度(km/h)=%.3f 单位=%c 定位模式=%c 校验和=*%s",
+              vtg.course_true, log_char(vtg.course_true_unit),
+              vtg.course_mag, log_char(vtg.course_mag_unit),
+              vtg.speed_knots, log_char(vtg.speed_knots_unit),
+              vtg.speed_kmh, log_char(vtg.speed_kmh_unit),
+              log_char(vtg.mode), vtg.checksum);
+#endif
+    } else if (strncmp(tag, NMEA_TAG_GSA, 3) == 0) {
+        GSA gsa;
+        parse_gsa(line, len, &gsa);
+        if (cb.onGsa) {
+            cb.onGsa(gsa);
+        }
+#ifdef GNSS_DEBUG
+        /* 打印 GSA 解析出的全部 18 个字段（中文，便于调试） */
+        ALOGD("[GSA] 模式1=%c 模式2=%d "
+              "PRN1=%d PRN2=%d PRN3=%d PRN4=%d PRN5=%d PRN6=%d "
+              "PRN7=%d PRN8=%d PRN9=%d PRN10=%d PRN11=%d PRN12=%d "
+              "PDOP=%.2f HDOP=%.2f VDOP=%.2f 系统ID=%d 校验和=*%s",
+              log_char(gsa.mode1), gsa.mode2,
+              gsa.prn[0], gsa.prn[1], gsa.prn[2], gsa.prn[3],
+              gsa.prn[4], gsa.prn[5], gsa.prn[6], gsa.prn[7],
+              gsa.prn[8], gsa.prn[9], gsa.prn[10], gsa.prn[11],
+              gsa.pdop, gsa.hdop, gsa.vdop, gsa.system_id, gsa.checksum);
+#endif
+    } else if (strncmp(tag, NMEA_TAG_GSV, 3) == 0) {
+        GSV gsv;
+        parse_gsv(line, len, &gsv);
+        if (cb.onGsv) {
+            cb.onGsv(gsv);
+        }
+#ifdef GNSS_DEBUG
+        /* 打印 GSV 解析出的 20 个字段（GSVField 1~20：头部3 + 卫星4×4 + 信号ID1，中文便于调试）。
+         * talker 前缀用于区分 GP/GL/GA/GB/GQ 五种 GSV。 */
+        ALOGD("[GSV:%s] 总帧数=%d 当前帧=%d 可见卫星数=%d "
+              "星1(sv=%d el=%d az=%d cno=%d) "
+              "星2(sv=%d el=%d az=%d cno=%d) "
+              "星3(sv=%d el=%d az=%d cno=%d) "
+              "星4(sv=%d el=%d az=%d cno=%d) "
+              "信号ID=%d 校验和=*%s",
+              gsv.talker,
+              gsv.total_messages, gsv.message_number, gsv.satellites_in_view,
+              gsv.satellites[0].svid, gsv.satellites[0].elevation,
+              gsv.satellites[0].azimuth, gsv.satellites[0].cno,
+              gsv.satellites[1].svid, gsv.satellites[1].elevation,
+              gsv.satellites[1].azimuth, gsv.satellites[1].cno,
+              gsv.satellites[2].svid, gsv.satellites[2].elevation,
+              gsv.satellites[2].azimuth, gsv.satellites[2].cno,
+              gsv.satellites[3].svid, gsv.satellites[3].elevation,
+              gsv.satellites[3].azimuth, gsv.satellites[3].cno,
+              gsv.signal_id, gsv.checksum);
+#endif
+    }
+}
+
+/* 循环读取串口：切行后解析并通过 cb 回调结构化数据，再打印到 logcat。 */
+int nmea_serial_read_loop(int fd, const NmeaCallbacks& cb) {
+    char buf[SERIAL_READ_BUF];
+    for (;;) {
+        const int n = nmea_serial_read(fd, buf, sizeof(buf));
+        if (n > 0) {
+            line_feed(buf, n, [&cb](const char* line, int len) {
+#ifdef GNSS_DEBUG_2
+                ALOGD("[nmea] %.*s", len, line);
+#endif
+                handle_line(line, len, cb);
+            });
+        } else if (n < 0 && errno == EINTR) {
+            continue;  /* 信号打断，重试 */
+        } else if (n < 0) {
+            ALOGE("%s: read failed: %s", __func__, strerror(errno));
+            return -1;
+        } else {
+            /* n == 0：100ms 超时无数据，视为一包 NMEA 结束，触发 onIdle 让上层收敛上报 */
+            if (cb.onIdle) {
+                cb.onIdle();
+            }
+        }
+    }
+    return 0;
+}
