+namespace android {
+namespace hardware {
+namespace gnss {
+namespace V2_1 {
+namespace implementation {
+
+using ::android::hardware::gnss::V2_1::nmea::GGA;
+using ::android::hardware::gnss::V2_1::nmea::GSA;
+using ::android::hardware::gnss::V2_1::nmea::GSV;
+using ::android::hardware::gnss::V2_1::nmea::RMC;
+using ::android::hardware::gnss::V2_1::nmea::SERIAL_DEV_DEFAULT;
+using ::android::hardware::gnss::V2_1::nmea::nmea_serial_close;
+using ::android::hardware::gnss::V2_1::nmea::nmea_serial_open;
+using ::android::hardware::gnss::V2_1::nmea::nmea_serial_read_loop;
+
+/* ============================================================================================
+ * 上报用辅助函数
+ * ========================================================================================== */
+
+/* 节 → 米/秒 的换算系数。RMC 报的是节，HAL 定位结构用的是 米/秒。 */
+static constexpr float kKnotsToMps = 0.514444f;
+
+/* 把 GSV 语句的 talker 前缀（"GP"/"GL"/"GA"/"GB"/"GQ"）映射成 HAL 的星座枚举。
+ * 用在卫星上报时区分每颗卫星属于哪个导航系统。 */
+static V2_0::GnssConstellationType talkerToConstellation(const char* talker) {
+    if (strncmp(talker, "GP", 2) == 0) return V2_0::GnssConstellationType::GPS;
+    if (strncmp(talker, "GL", 2) == 0) return V2_0::GnssConstellationType::GLONASS;
+    if (strncmp(talker, "GA", 2) == 0) return V2_0::GnssConstellationType::GALILEO;
+    if (strncmp(talker, "GB", 2) == 0) return V2_0::GnssConstellationType::BEIDOU;
+    if (strncmp(talker, "GQ", 2) == 0) return V2_0::GnssConstellationType::QZSS;
+    return V2_0::GnssConstellationType::UNKNOWN;
+}
+
+/* 把 GSA 语句的 system_id（1=GPS 2=GLONASS 3=Galileo 4=BeiDou 5=QZSS）映射成 HAL 星座枚举。
+ * 用于把参与解算的卫星号按星座归类，再和 GSV 的卫星对应起来标 USE_IN_FIX。 */
+static V2_0::GnssConstellationType gsaSystemToConstellation(int systemId) {
+    switch (systemId) {
+        case 1: return V2_0::GnssConstellationType::GPS;
+        case 2: return V2_0::GnssConstellationType::GLONASS;
+        case 3: return V2_0::GnssConstellationType::GALILEO;
+        case 4: return V2_0::GnssConstellationType::BEIDOU;
+        case 5: return V2_0::GnssConstellationType::QZSS;
+        default: return V2_0::GnssConstellationType::UNKNOWN;
+    }
+}
+
+/* 把 NMEA 的日期（ddmmyy）和时间（hhmmss.sss）合成 epoch 毫秒（UTC 时间戳）。
+ * 用作定位结构里的 timestamp 字段。日期或时间字段缺失/过短时返回 0。 */
+static int64_t nmeaPartsToUtcMs(const char* timeStr, const char* dateStr) {
+    if (timeStr == nullptr || dateStr == nullptr || strlen(dateStr) < 6 || strlen(timeStr) < 6) {
+        return 0;
+    }
+
+    struct tm tm = {};
+    tm.tm_mday = (dateStr[0] - '0') * 10 + (dateStr[1] - '0');
+    tm.tm_mon = (dateStr[2] - '0') * 10 + (dateStr[3] - '0') - 1;
+    tm.tm_year = (dateStr[4] - '0') * 10 + (dateStr[5] - '0') + 100;  // 自 1900 计
+    tm.tm_hour = (timeStr[0] - '0') * 10 + (timeStr[1] - '0');
+    tm.tm_min = (timeStr[2] - '0') * 10 + (timeStr[3] - '0');
+    tm.tm_sec = (timeStr[4] - '0') * 10 + (timeStr[5] - '0');
+
+    /* timegm 按 UTC 解释，不需再减本地时区偏移 */
+    return static_cast<int64_t>(timegm(&tm)) * 1000;
+}
+
+/* 用 GGA（位置/海拔/HDOP）和 RMC（速度/航向/时间戳）合成一个 HAL 定位结构。
+ * 经纬度直接用 GGA 已换算并带 N/S、E/W 符号的十进制度；速度由节转米/秒。 */
+static V2_0::GnssLocation makeLocation(const GGA& gga, const RMC& rmc) {
+    /* 定位事件对应的 elapsedRealtime 时钟（Android 开机以来的纳秒） */
+    V2_0::ElapsedRealtime elapsed = {
+            .flags = V2_0::ElapsedRealtimeFlags::HAS_TIMESTAMP_NS |
+                     V2_0::ElapsedRealtimeFlags::HAS_TIME_UNCERTAINTY_NS,
+            .timestampNs = static_cast<uint64_t>(::android::elapsedRealtimeNano()),
+            .timeUncertaintyNs = 1000000};
+
+    /* 标明本次定位有哪些字段有效 */
+    V1_0::GnssLocationFlags flags =
+            static_cast<V1_0::GnssLocationFlags>(
+                    V1_0::GnssLocationFlags::HAS_LAT_LONG |
+                    V1_0::GnssLocationFlags::HAS_ALTITUDE |
+                    V1_0::GnssLocationFlags::HAS_SPEED |
+                    V1_0::GnssLocationFlags::HAS_BEARING |
+                    V1_0::GnssLocationFlags::HAS_HORIZONTAL_ACCURACY);
+
+    V1_0::GnssLocation v1 = {
+            .gnssLocationFlags = static_cast<uint16_t>(flags),
+            .latitudeDegrees = gga.latitude,
+            .longitudeDegrees = gga.longitude,
+            .altitudeMeters = static_cast<double>(gga.altitude),
+            .speedMetersPerSec = rmc.speed_knots * kKnotsToMps,
+            .bearingDegrees = rmc.course_deg,
+            .horizontalAccuracyMeters = gga.hdop,
+            .verticalAccuracyMeters = 0.0f,
+            .speedAccuracyMetersPerSecond = 0.0f,
+            .bearingAccuracyDegrees = 0.0f,
+            .timestamp = nmeaPartsToUtcMs(rmc.utc_time, rmc.date)};
+
+    return V2_0::GnssLocation{.v1_0 = v1, .elapsedRealtime = elapsed};
+}
+
+/* 用 GSV 里的一颗卫星字段构造 HAL 卫星结构。
+ * - 基础字段（svid/仰角/方位角/载噪比）来自卫星自身上报；
+ * - 星座类型由调用方传入；
+ * - usedInFix 决定是否打 USED_IN_FIX 标志（来自 GSA 参与解算卫星集合）。 */
+static V2_1::IGnssCallback::GnssSvInfo makeSvInfo(
+        const nmea::GSVSatellite& sat, V2_0::GnssConstellationType cons, bool usedInFix) {
+    V2_1::IGnssCallback::GnssSvInfo info;
+
+    info.v2_0.v1_0.svid = static_cast<int16_t>(sat.svid);
+    /* v1_0.constellation 在 2.0 起已废弃，真正生效的是下方的 v2_0.constellation */
+    info.v2_0.v1_0.constellation = V1_0::GnssConstellationType::UNKNOWN;
+    info.v2_0.v1_0.cN0Dbhz = static_cast<float>(sat.cno);
+    info.v2_0.v1_0.elevationDegrees = static_cast<float>(sat.elevation);
+    info.v2_0.v1_0.azimuthDegrees = static_cast<float>(sat.azimuth);
+    info.v2_0.v1_0.carrierFrequencyHz = 0.0f;  // 0 表示主频（如 GPS L1），未细分信号
+    info.v2_0.v1_0.svFlag =
+            usedInFix ? static_cast<uint8_t>(V1_0::IGnssCallback::GnssSvFlags::USED_IN_FIX)
+                      : static_cast<uint8_t>(V1_0::IGnssCallback::GnssSvFlags::NONE);
+
+    info.v2_0.constellation = cons;
+    info.basebandCN0DbHz = static_cast<double>(sat.cno);
+
+    return info;
+}
+
+/* ============================================================================================
+ * 串口读取线程的累计状态
+ *
+ * 该结构体只在串口线程内被读写，无需额外加锁。makeNmeaCallbacks 返回的回调会通过引用
+ * 修改这里的状态，并按需组装 HAL 结构上报。
+ * ========================================================================================== */
+
+struct Gnss::ReportState {
+    /* 定位：缓存最新 GGA 和 RMC，两条都到且 RMC 有效时才合成上报 */
+    bool hasGga = false;
+    bool hasRmc = false;
+    GGA latestGga{};
+    RMC latestRmc{};
+
+    /* 卫星：按星座聚合最新卫星；再按星座记录参与解算的卫星号集合 */
+    std::map<V2_0::GnssConstellationType,
+             std::map<int16_t, V2_1::IGnssCallback::GnssSvInfo>> svByConstellation;
+    std::map<V2_0::GnssConstellationType, std::set<int16_t>> usedPrnByConstellation;
+};
+
+/* 把当前累积的卫星汇总上报一次，并清空累积表。
+ * 以 GGA 为周期边界：新的 GGA 到达时说明上一轮数据已凑齐，调用本函数把上轮完整卫星上报。 */
+void Gnss::flushSvReport(ReportState& state) {
+    size_t total = 0;
+    for (const auto& kv : state.svByConstellation) {
+        total += kv.second.size();
+    }
+
+    if (total > 0) {
+        hidl_vec<V2_1::IGnssCallback::GnssSvInfo> svInfoList(total);
+        size_t idx = 0;
+        for (const auto& kv : state.svByConstellation) {
+            for (const auto& svEntry : kv.second) {
+                svInfoList[idx++] = svEntry.second;
+            }
+        }
+        ALOGI("serial thread: report sv status count=%zu", svInfoList.size());
+        this->reportSvStatus(svInfoList);
+    }
+
+    /* 清空聚合表，开始新一轮累积 */
+    state.svByConstellation.clear();
+}
+
+/* 构造 NMEA 解析回调。返回的回调会读/写 state，并在数据齐全时调用 reportLocation /
+ * reportSvStatus 上报给 framework。 */
+nmea::NmeaCallbacks Gnss::makeNmeaCallbacks(ReportState& state) {
+    nmea::NmeaCallbacks cb;
+
+    /* 收到 GGA：只缓存，等 RMC 到达后合成定位。
+     * 卫星的上报时机不在这里，而是等一包数据静默结束后由 onIdle 触发。 */
+    cb.onGga = [&state](const GGA& gga) {
+        state.latestGga = gga;
+        state.hasGga = true;
+    };
+
+    /* 收到 RMC：缓存，并在定位有效且已有 GGA 时合成上报 */
+    cb.onRmc = [this, &state](const RMC& rmc) {
+        state.latestRmc = rmc;
+        state.hasRmc = true;
+        if (state.hasGga && rmc.status == 'A') {
+            const V2_0::GnssLocation location = makeLocation(state.latestGga, state.latestRmc);
+            ALOGI("serial thread: report location lat=%.7f lon=%.7f alt=%.2f spd=%.3f",
+                  location.v1_0.latitudeDegrees, location.v1_0.longitudeDegrees,
+                  location.v1_0.altitudeMeters, location.v1_0.speedMetersPerSec);
+            this->reportLocation(location);
+        }
+    };
+
+    /* 收到 GSA：刷新该星座参与解算的卫星号集合，供给卫星打 USED_IN_FIX */
+    cb.onGsa = [&state](const GSA& gsa) {
+        const V2_0::GnssConstellationType cons = gsaSystemToConstellation(gsa.system_id);
+        auto& usedPrn = state.usedPrnByConstellation[cons];
+        usedPrn.clear();
+        for (int i = 0; i < 12; ++i) {
+            if (gsa.prn[i] > 0) {
+                usedPrn.insert(static_cast<int16_t>(gsa.prn[i]));
+            }
+        }
+    };
+
+    /* 收到 GSV：把本帧卫星按 (星座, svid) 覆盖累积。
+     * 同一星座不同频段（L1/L5 等）发出的同号卫星会被自动去重覆盖；
+     * 本回调不上报也不清空，上报时机由 onIdle 触发。 */
+    cb.onGsv = [&state](const GSV& gsv) {
+        const V2_0::GnssConstellationType cons = talkerToConstellation(gsv.talker);
+        auto& svMap = state.svByConstellation[cons];
+        for (int i = 0; i < gsv.satellite_count; ++i) {
+            const nmea::GSVSatellite& sat = gsv.satellites[i];
+            if (sat.svid == 0) {
+                continue;
+            }
+            const bool used = state.usedPrnByConstellation[cons].count(sat.svid) > 0;
+            svMap[static_cast<int16_t>(sat.svid)] = makeSvInfo(sat, cons, used);
+        }
+    };
+
+    /* 串口 100ms 无数据：一包 NMEA 已结束，把本包累积的卫星上报一次并清空。 */
+    cb.onIdle = [this, &state]() {
+        this->flushSvReport(state);
+    };
+
+    return cb;
+}
+
+Gnss::Gnss() : mIsActive(false), mSerialFd(-1) {
+    ALOGI("Gnss constructed");
+}
+
+Gnss::~Gnss() {
+    ALOGI("Gnss destructor");
+    stop();
+}
+
+Return<bool> Gnss::start() {
+    ALOGI("Gnss::start() called");
+    if (mIsActive) {
+        ALOGW("Gnss has started. Restarting...");
+        stop();
+    }
+
+    mIsActive = true;
+    ALOGI("Gnss::start() reporting SESSION_BEGIN");
+    this->reportGnssStatusValue(V1_0::IGnssCallback::GnssStatusValue::SESSION_BEGIN);
+
+    mThread = std::thread([this]() {
+        ALOGI("serial thread: opening %s", SERIAL_DEV_DEFAULT);
+        mSerialFd = nmea_serial_open(SERIAL_DEV_DEFAULT);
+        if (mSerialFd < 0) {
+            ALOGE("serial thread: open %s failed, serial thread exiting", SERIAL_DEV_DEFAULT);
+            return;
+        }
+        ALOGI("serial thread: %s opened, entering read loop (fd=%d)", SERIAL_DEV_DEFAULT,
+              mSerialFd.load());
+
+        /* 线程内累计状态 + 回调，解析结果在此组装并上报 */
+        ReportState state;
+        const nmea::NmeaCallbacks cb = makeNmeaCallbacks(state);
+
+        const int ret = nmea_serial_read_loop(mSerialFd, cb);
+        ALOGW("serial thread: read loop exited with ret=%d (errno=%d, %s)", ret, errno,
+              strerror(errno));
+
+        nmea_serial_close(mSerialFd);
+        mSerialFd = -1;
+        ALOGI("serial thread: %s closed", SERIAL_DEV_DEFAULT);
+    });
+
+    ALOGI("Gnss::start() done");
+    return true;
+}
+
+Return<bool> Gnss::stop() {
+    ALOGI("Gnss::stop() called");
+    mIsActive = false;
+
+    // Closing the fd unblocks the blocking read() inside nmea_serial_read_loop,
+    // letting the thread wind down and join() return.
+    if (mSerialFd >= 0) {
+        ALOGI("Gnss::stop() closing serial fd=%d", mSerialFd.load());
+        nmea_serial_close(mSerialFd);
+        mSerialFd = -1;
+    }
+
+    if (mThread.joinable()) {
+        ALOGI("Gnss::stop() joining serial thread");
+        mThread.join();
+        ALOGI("Gnss::stop() serial thread joined");
+    }
+
+    ALOGI("Gnss::stop() reporting SESSION_END");
+    this->reportGnssStatusValue(V1_0::IGnssCallback::GnssStatusValue::SESSION_END);
+    ALOGI("Gnss::stop() done");
+    return true;
+}
+
