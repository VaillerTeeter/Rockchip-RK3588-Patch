+
+using ::android::hardware::gnss::common::implementation::GnssTemplate;
+
+struct Gnss : public GnssTemplate<IGnss> {
+    Gnss();
+    ~Gnss();
+
+    // Methods from V1_0::IGnss (re-implemented to drive the serial port).
+    Return<bool> start() override;
+    Return<bool> stop() override;
+
+  private:
+    /* 串口读取线程的累计状态（缓存最新 GGA/RMC/卫星等），完整定义在 Gnss.cpp */
+    struct ReportState;
+
+    /* 构造 NMEA 解析回调：把解析结果组装成 HAL 定位/卫星数据并上报 */
+    nmea::NmeaCallbacks makeNmeaCallbacks(ReportState& state);
+
+    /* 把当前累积的卫星汇总上报一次，并清空累积表（在下一轮 GGA 到来时调用） */
+    void flushSvReport(ReportState& state);
+
+    std::atomic<bool> mIsActive;
+    std::atomic<int> mSerialFd;
+    std::thread mThread;
+};
