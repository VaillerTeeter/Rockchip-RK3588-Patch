From 26e5f962489444c4a3c96bef9d6a0f097f1320ef Mon Sep 17 00:00:00 2001
From: Vaciller <wyc_19533480830@outlook.com>
Date: Sat, 11 Jul 2026 21:15:36 +0800
Subject: [PATCH 70/78] feat: add Rockchip TvSettings display, advance
 settings, VPN, hotspot, keyboard layout, and ShowDialogService activity
 declarations

Change-Id: I448112e69c1b98d4c8362a25281324377aa17a9c
---
 Settings/AndroidManifest.xml | 74 ++++++++++++++++++++++++++++++++++--
 1 file changed, 71 insertions(+), 3 deletions(-)

diff --git a/Settings/AndroidManifest.xml b/Settings/AndroidManifest.xml
index 3502483ed..363437eeb 100644
--- a/Settings/AndroidManifest.xml
+++ b/Settings/AndroidManifest.xml
@@ -1270,14 +1270,82 @@
             </intent-filter>
         </activity>
 
-        <receiver
-            android:name=".GlobalKeyReceiver"
-            android:exported="true">
+        <receiver android:name=".GlobalKeyReceiver" android:exported="true">
             <intent-filter>
                 <action android:name="android.intent.action.GLOBAL_BUTTON"/>
             </intent-filter>
         </receiver>
 
+        <activity
+            android:theme="@style/Transparent"
+            android:name="com.android.tv.settings.display.DisplayActivity"
+            android:exported="true" />
+        <activity
+            android:theme="@style/TvSettingsActivityTheme"
+            android:name="com.android.tv.settings.display.ScreenScaleActivity"
+            android:exported="false" />
+        <activity
+            android:theme="@style/TvSettingsActivityTheme"
+            android:name="com.android.tv.settings.display.AdvancedDisplaySettingsActivity"
+            android:exported="false" />
+        <activity
+            android:theme="@style/TvSettingsActivityTheme"
+            android:name="com.android.tv.settings.display.AIDisplayActivity"
+            android:launchMode="singleTop"
+            android:excludeFromRecents="true"
+            android:exported="true" />
+        <activity
+            android:name=".advance_settings.AdvanceSettingsActivity"
+            android:theme="@style/TvSettingsActivityTheme"
+            android:excludeFromRecents="true"
+            android:exported="true" >
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <action android:name="android.settings.DEVICE_INFO_SETTINGS" />
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+        </activity>
+
+        <service android:name=".advance_settings.performance.PerformanceService" android:exported="true"/>
+
+        <activity
+            android:name="com.android.tv.settings.vpn.VpnCreateActivity"
+            android:configChanges="keyboard"
+            android:windowSoftInputMode="adjustPan"
+            android:exported="false" >
+            <intent-filter>
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+        </activity>
+
+        <activity
+            android:name=".connectivity.HotspotActivity"
+            android:exported="false" >
+        </activity>
+        <activity
+            android:name=".connectivity.HotspotDialogActivity"
+            android:exported="false" >
+            <intent-filter>
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+        </activity>
+
+        <activity
+            android:name=".inputmethod.KeyboardLayoutPickerActivity"
+            android:label="@string/keyboard_layout_picker_title"
+            android:exported="false" >
+            <intent-filter>
+                <category android:name="android.intent.category.DEFAULT" />
+            </intent-filter>
+            <meta-data android:name="com.android.tv.settings.FRAGMENT_CLASS"
+                android:value="com.android.tv.settings.inputmethod.KeyboardLayoutPickerFragment" />
+        </activity>
+
+        <service
+            android:name=".ShowDialogService"
+            android:enabled="true"
+            android:exported="true"
+            android:permission="android.permission.GET_TASKS" />
     </application>
 
 </manifest>
-- 
2.53.0

