+    private final int HIDE_MANUAL_FOCUS_BAR = 0;
+    private Handler mHandler = new Handler() {
+        public void dispatchMessage(android.os.Message msg) {
+            if (msg.what == HIDE_MANUAL_FOCUS_BAR) {
+                hideManualFocusBar();
+            }
+        };
+    };
