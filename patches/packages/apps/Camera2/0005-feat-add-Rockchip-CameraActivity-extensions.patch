+                String cameraScope = SettingsManager.CAMERA_SCOPE_PREFIX + cameraId[i];
+                if (mSettingsManager.isSet(cameraScope, Keys.KEY_EXPOSURE)) {
+                    mSettingsManager.set(cameraScope, Keys.KEY_EXPOSURE, 0);
+                }
+            }
+        }
