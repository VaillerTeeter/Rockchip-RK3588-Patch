         File cacheDir = context.getExternalCacheDir();
+        if(cacheDir == null || !cacheDir.exists()){
+            return ;
+        }
         String prefix = cacheDir.getAbsolutePath() + "/";
 
         BlobCache.deleteFiles(prefix + "imgcache");
