From a7dbba45c9553b0ee416894e59f3f4a1cde8c546 Mon Sep 17 00:00:00 2001
From: Vaciller <wyc_19533480830@outlook.com>
Date: Fri, 10 Jul 2026 11:30:18 +0800
Subject: [PATCH 1/6] feat: add Rockchip library dependencies and build flags
 to recovery

Change-Id: I68cb74dfef8a66def52986129117a1eab6d5a11d
---
 Android.bp                | 16 ++++++++++++++++
 Android.mk                |  3 ++-
 install/Android.bp        |  2 ++
 recovery_utils/Android.bp |  2 ++
 4 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/Android.bp b/Android.bp
index bd957050..030eb337 100644
--- a/Android.bp
+++ b/Android.bp
@@ -114,6 +114,9 @@ cc_defaults {
         "libotautil",
         "libsnapshot_nobinder",
         "update_metadata-protos",
+        "libmtdutils",
+        "librkutility",
+        "librkupdate",
     ],
 }
 
@@ -132,6 +135,10 @@ cc_library_static {
     shared_libs: [
         "librecovery_ui",
     ],
+
+    static_libs: [
+        "librkfactory_test",
+    ],
 }
 
 prebuilt_etc {
@@ -146,6 +153,10 @@ cc_binary {
     name: "recovery",
     recovery: true,
 
+    cppflags: [
+        "-DLogToSerial",
+    ],
+
     defaults: [
         "libinstall_defaults",
         "librecovery_defaults",
@@ -164,6 +175,11 @@ cc_binary {
     static_libs: [
         "librecovery",
         "librecovery_ui_default",
+        "libmtdutils",
+        "librkutility",
+        "librkupdate",
+        "librkwifi-ctrl-static",
+        "librkfactory_test",
     ],
 
     required: [
diff --git a/Android.mk b/Android.mk
index 8506040f..9eddf679 100644
--- a/Android.mk
+++ b/Android.mk
@@ -71,7 +71,8 @@ endif
 LOCAL_REQUIRED_MODULES += \
     mkfs.erofs.recovery \
     dump.erofs.recovery \
-    fsck.erofs.recovery
+    fsck.erofs.recovery \
+    tune2fs.recovery
 
 # On A/B devices recovery-persist reads the recovery related file from the persist storage and
 # copies them into /data/misc/recovery. Then, for both A/B and non-A/B devices, recovery-persist
diff --git a/install/Android.bp b/install/Android.bp
index c5917145..a1e9eba9 100644
--- a/install/Android.bp
+++ b/install/Android.bp
@@ -54,6 +54,8 @@ cc_defaults {
 
         // external dependencies
         "libvintf",
+        "libmtdutils",
+        "librkupdate",
     ],
 }
 
diff --git a/recovery_utils/Android.bp b/recovery_utils/Android.bp
index 9bd66c5d..c1257f2a 100644
--- a/recovery_utils/Android.bp
+++ b/recovery_utils/Android.bp
@@ -41,6 +41,7 @@ cc_defaults {
 
     static_libs: [
         "libotautil",
+        "librkutility",
 
         // External dependencies.
         "android.hardware.health-translate-ndk",
@@ -98,5 +99,6 @@ cc_library_static {
         "//bootable/recovery/install",
         "//bootable/recovery/minadbd",
         "//bootable/recovery/tests",
+        "//bootable/recovery/pcba_core",
     ],
 }
