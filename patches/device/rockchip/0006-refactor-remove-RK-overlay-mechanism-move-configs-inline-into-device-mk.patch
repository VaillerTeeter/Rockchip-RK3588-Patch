From b2cdee118e6cac99fab935259cb4c8b554e53918 Mon Sep 17 00:00:00 2001
From: Vaciller <wyc_19533480830@outlook.com>
Date: Fri, 7 Aug 2026 01:06:14 +0800
Subject: [PATCH] refactor: remove RK overlay mechanism, move configs inline
 into device mk

    Drop DEVICE_PACKAGE_OVERLAYS and delete all overlay files for
    ATK_DLRK3588 (Wifi, wallpaper, framework config, SettingsProvider
    defaults, SystemUI). Move previously overlay-driven settings
    (qemu.hw.mainkeys, persist.sys.headunit_navbar) directly into
    PRODUCT_PROPERTY_OVERRIDES.
---
 rk3588/ATK_DLRK3588/ATK_DLRK3588.mk           |   2 -
 .../res/values/config.xml                     |  25 ------
 .../res/drawable-nodpi/default_wallpaper.png  | Bin 69 -> 0 bytes
 .../default_wallpaper.png                     | Bin 69 -> 0 bytes
 .../default_wallpaper.png                     | Bin 69 -> 0 bytes
 .../base/core/res/res/values/config.xml       |  75 ------------------
 .../SettingsProvider/res/values/defaults.xml  |  42 ----------
 .../packages/SystemUI/res/values/config.xml   |  32 --------
 .../packages/SystemUI/res/values/config.xml   |  24 ------
 9 files changed, 200 deletions(-)
 delete mode 100644 rk3588/ATK_DLRK3588/overlay/packages/modules/Wifi/service/ServiceWifiResources/res/values/config.xml
 delete mode 100755 rk3588/overlay/frameworks/base/core/res/res/drawable-nodpi/default_wallpaper.png
 delete mode 100755 rk3588/overlay/frameworks/base/core/res/res/drawable-sw600dp-nodpi/default_wallpaper.png
 delete mode 100755 rk3588/overlay/frameworks/base/core/res/res/drawable-sw720dp-nodpi/default_wallpaper.png
 delete mode 100755 rk3588/overlay/frameworks/base/core/res/res/values/config.xml
 delete mode 100755 rk3588/overlay/frameworks/base/packages/SettingsProvider/res/values/defaults.xml
 delete mode 100755 rk3588/overlay/frameworks/base/packages/SystemUI/res/values/config.xml
 delete mode 100644 rk3588/overlay/packages/SystemUI/res/values/config.xml

diff --git a/rk3588/ATK_DLRK3588/ATK_DLRK3588.mk b/rk3588/ATK_DLRK3588/ATK_DLRK3588.mk
index b759112..35a4a8c 100644
--- a/rk3588/ATK_DLRK3588/ATK_DLRK3588.mk
+++ b/rk3588/ATK_DLRK3588/ATK_DLRK3588.mk
@@ -25,8 +25,6 @@ include device/rockchip/rk3588/ATK_DLRK3588/preinstall/preinstall.mk
 
 $(call inherit-product, device/rockchip/rk3588/device.mk)
 $(call inherit-product, device/rockchip/common/device.mk)
-DEVICE_PACKAGE_OVERLAYS += $(LOCAL_PATH)/../overlay
-DEVICE_PACKAGE_OVERLAYS += $(LOCAL_PATH)/overlay
 
 PRODUCT_CHARACTERISTICS := tablet
 
