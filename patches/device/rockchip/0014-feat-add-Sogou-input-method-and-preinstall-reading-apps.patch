diff --git a/rk3588/ATK_DLRK3588/SogouInput/Android.mk b/rk3588/ATK_DLRK3588/SogouInput/Android.mk
new file mode 100644
index 0000000..670ab8c
--- /dev/null
+++ b/rk3588/ATK_DLRK3588/SogouInput/Android.mk
@@ -0,0 +1,25 @@
+LOCAL_PATH := $(call my-dir)
+
+# =============================================================================
+# SogouInput — system app IME.
+#
+# Installed into /system/app so it is flagged FLAG_SYSTEM and thus eligible to
+# become the default/enabled input method (InputMethodUtils only auto-enables
+# isSystem() IMEs).
+#
+# IMPORTANT: do NOT set LOCAL_PREBUILT_JNI_LIBS here. BUILD_PREBUILT re-zips
+# the APK when native libs are pre-extracted, which strips the vendor's
+# v2/v3 signature. Since this APK targets SDK 33 (>= 30), PackageManager
+# rejects a v1-only APK on boot. Keep the APK byte-for-byte intact; its .so
+# libraries are extracted at install time by installd.
+# =============================================================================
+include $(CLEAR_VARS)
+LOCAL_MODULE := SogouInput
+LOCAL_MODULE_CLASS := APPS
+LOCAL_MODULE_TAGS := optional
+LOCAL_BUILT_MODULE_STEM := package.apk
+LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+LOCAL_SRC_FILES := SogouInput.apk
+LOCAL_CERTIFICATE := PRESIGNED
+LOCAL_DEX_PREOPT := false
+include $(BUILD_PREBUILT)
\ No newline at end of file
diff --git a/rk3588/ATK_DLRK3588/SogouInput/default-permissions.xml b/rk3588/ATK_DLRK3588/SogouInput/default-permissions.xml
new file mode 100644
index 0000000..ff619c9
--- /dev/null
+++ b/rk3588/ATK_DLRK3588/SogouInput/default-permissions.xml
@@ -0,0 +1,16 @@
+<?xml version="1.0" encoding="utf-8"?>
+<exceptions>
+    <exception package="com.sohu.inputmethod.sogou">
+        <!-- Runtime dangerous permissions - auto granted on boot -->
+        <permission name="android.permission.RECORD_AUDIO" fixed="true"/>
+        <permission name="android.permission.CAMERA" fixed="true"/>
+        <permission name="android.permission.READ_EXTERNAL_STORAGE" fixed="true"/>
+        <permission name="android.permission.WRITE_EXTERNAL_STORAGE" fixed="true"/>
+        <permission name="android.permission.READ_MEDIA_IMAGES" fixed="true"/>
+        <permission name="android.permission.READ_MEDIA_VIDEO" fixed="true"/>
+        <permission name="android.permission.READ_MEDIA_AUDIO" fixed="true"/>
+        <permission name="android.permission.WRITE_CALENDAR" fixed="true"/>
+        <permission name="android.permission.POST_NOTIFICATIONS" fixed="true"/>
+        <permission name="android.permission.FOREGROUND_SERVICE" fixed="true"/>
+    </exception>
+</exceptions>
\ No newline at end of file
