 rk3588/ATK_DLRK3588/preinstall/Android.mk     |  2 -
 .../ATK_DLRK3588/preinstall/Auto/Android.mk   | 77 ------------------
 .../preinstall/TencentAppStore/Android.mk     | 11 ---
 rk3588/ATK_DLRK3588/preinstall/preinstall.mk  |  2 -
 .../stage/AnExplorer/default-permissions.xml  | 14 ++++
 rk3588/ATK_DLRK3588/stage/Android.mk          | 79 +++++++++++++++++++
 .../Auto/default-permissions.xml              |  0
 .../stage/BilibiliHD/default-permissions.xml  | 22 ++++++
 .../stage/Douyin/default-permissions.xml      | 22 ++++++
 .../stage/Emby/default-permissions.xml        | 15 ++++
 .../NeteaseCloudMusic/default-permissions.xml | 11 +++
 .../WallpaperEngine/default-permissions.xml   | 11 +++
 .../stage/Ximalaya/default-permissions.xml    | 21 +++++
 rk3588/ATK_DLRK3588/stage/preinstall.mk       |  8 ++
 15 files changed, 216 insertions(+), 95 deletions(-)
 delete mode 100644 rk3588/ATK_DLRK3588/preinstall/Android.mk
 delete mode 100644 rk3588/ATK_DLRK3588/preinstall/Auto/Android.mk
 delete mode 100644 rk3588/ATK_DLRK3588/preinstall/TencentAppStore/Android.mk
 delete mode 100644 rk3588/ATK_DLRK3588/preinstall/preinstall.mk
 create mode 100644 rk3588/ATK_DLRK3588/stage/AnExplorer/default-permissions.xml
 create mode 100644 rk3588/ATK_DLRK3588/stage/Android.mk
 rename rk3588/ATK_DLRK3588/{preinstall => stage}/Auto/default-permissions.xml (100%)
 create mode 100644 rk3588/ATK_DLRK3588/stage/BilibiliHD/default-permissions.xml
 create mode 100644 rk3588/ATK_DLRK3588/stage/Douyin/default-permissions.xml
 create mode 100644 rk3588/ATK_DLRK3588/stage/Emby/default-permissions.xml
 create mode 100644 rk3588/ATK_DLRK3588/stage/NeteaseCloudMusic/default-permissions.xml
