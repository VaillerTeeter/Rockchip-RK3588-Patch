diff --git a/rk3588/ATK_DLRK3588/stage/Android.mk b/rk3588/ATK_DLRK3588/stage/Android.mk
new file mode 100644
index 0000000..5c5ea1d
--- /dev/null
+++ b/rk3588/ATK_DLRK3588/stage/Android.mk
@@ -0,0 +1,79 @@
+LOCAL_PATH := $(call my-dir)
+
+# =============================================================================
+# Stage-only APKs.
+#
+# These large third-party APKs must NOT be installed into the system app dir.
+# They are shipped as plain files under /system/preinstall, then installed
+# into /data/app at first boot by SystemServer.installPreinstalledCarApps()
+# (before AMS starts home), so their unpacked native libs and app data live
+# on the 512G NVMe /data partition.
+#
+# This directory is intentionally named "stage" (not "preinstall") so it is
+# NOT scanned by device/rockchip/common/auto_generator.py, which would
+# otherwise regenerate this Android.mk and preinstall.mk on every build.
+# =============================================================================
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := AutoPreinstall
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT)/preinstall
+LOCAL_MODULE_STEM := Auto.apk
+LOCAL_SRC_FILES := Auto/Auto.apk
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := NeteaseCloudMusicPreinstall
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT)/preinstall
+LOCAL_MODULE_STEM := NeteaseCloudMusic.apk
+LOCAL_SRC_FILES := NeteaseCloudMusic/NeteaseCloudMusic.apk
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := XimalayaPreinstall
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT)/preinstall
+LOCAL_MODULE_STEM := Ximalaya.apk
+LOCAL_SRC_FILES := Ximalaya/Ximalaya.apk
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := DouyinPreinstall
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT)/preinstall
+LOCAL_MODULE_STEM := Douyin.apk
+LOCAL_SRC_FILES := Douyin/Douyin.apk
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := BilibiliHDPreinstall
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT)/preinstall
+LOCAL_MODULE_STEM := BilibiliHD.apk
+LOCAL_SRC_FILES := BilibiliHD/BilibiliHD.apk
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := EmbyPreinstall
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT)/preinstall
+LOCAL_MODULE_STEM := Emby.apk
+LOCAL_SRC_FILES := Emby/Emby.apk
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := WallpaperEnginePreinstall
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT)/preinstall
+LOCAL_MODULE_STEM := WallpaperEngine.apk
+LOCAL_SRC_FILES := WallpaperEngine/WallpaperEngine.apk
+include $(BUILD_PREBUILT)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := AnExplorerPreinstall
+LOCAL_MODULE_CLASS := ETC
+LOCAL_MODULE_PATH := $(TARGET_OUT)/preinstall
+LOCAL_MODULE_STEM := AnExplorer.apk
+LOCAL_SRC_FILES := AnExplorer/AnExplorer.apk
+include $(BUILD_PREBUILT)
