-    device/rockchip/rk3588/ATK_DLRK3588/preinstall/Auto/default-permissions.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/default-permissions-auto.xml
+    device/rockchip/rk3588/ATK_DLRK3588/stage/Auto/default-permissions.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/default-permissions-auto.xml \
+    device/rockchip/rk3588/ATK_DLRK3588/stage/NeteaseCloudMusic/default-permissions.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/default-permissions-neteasecloudmusic.xml \
+    device/rockchip/rk3588/ATK_DLRK3588/stage/Ximalaya/default-permissions.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/default-permissions-ximalaya.xml \
+    device/rockchip/rk3588/ATK_DLRK3588/stage/Douyin/default-permissions.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/default-permissions-douyin.xml \
+    device/rockchip/rk3588/ATK_DLRK3588/stage/BilibiliHD/default-permissions.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/default-permissions-bilibilihd.xml \
+    device/rockchip/rk3588/ATK_DLRK3588/stage/Emby/default-permissions.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/default-permissions-emby.xml \
+    device/rockchip/rk3588/ATK_DLRK3588/stage/WallpaperEngine/default-permissions.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/default-permissions-wallpaperengine.xml \
+    device/rockchip/rk3588/ATK_DLRK3588/stage/AnExplorer/default-permissions.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/default-permissions/default-permissions-anexplorer.xml
 
 # =============================================================================
 # Display: 2x HiDPI scaling
