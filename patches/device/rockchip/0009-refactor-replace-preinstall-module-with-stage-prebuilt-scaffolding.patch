+# Pre-granted runtime permissions for staged third-party APKs.
+# First-boot installation is handled by SystemServer (installPreinstalledCarApps)
+# in frameworks/base; the APKs themselves are staged via BUILD_PREBUILT
+# (see stage/Android.mk) into /system/preinstall.
