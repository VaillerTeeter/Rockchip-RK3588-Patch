+include $(BUILD_PREBUILT)
diff --git a/rk3588/ATK_DLRK3588/preinstall/Auto/default-permissions.xml b/rk3588/ATK_DLRK3588/preinstall/Auto/default-permissions.xml
new file mode 100644
index 0000000..dcd5530
--- /dev/null
+++ b/rk3588/ATK_DLRK3588/preinstall/Auto/default-permissions.xml
@@ -0,0 +1,17 @@
+<?xml version="1.0" encoding="utf-8"?>
+<exceptions>
+    <exception package="com.autonavi.amapauto">
+        <!-- Runtime dangerous permissions - auto granted on boot -->
+        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="true"/>
+        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="true"/>
+        <permission name="android.permission.ACCESS_BACKGROUND_LOCATION" fixed="true"/>
+        <permission name="android.permission.READ_PHONE_STATE" fixed="true"/>
+        <permission name="android.permission.READ_EXTERNAL_STORAGE" fixed="true"/>
+        <permission name="android.permission.WRITE_EXTERNAL_STORAGE" fixed="true"/>
+        <permission name="android.permission.POST_NOTIFICATIONS" fixed="true"/>
+        <permission name="android.permission.BLUETOOTH_CONNECT" fixed="true"/>
+        <permission name="android.permission.BLUETOOTH_SCAN" fixed="true"/>
+        <permission name="android.permission.FOREGROUND_SERVICE" fixed="true"/>
+        <permission name="android.permission.RECEIVE_BOOT_COMPLETED" fixed="true"/>
+    </exception>
+</exceptions>
\ No newline at end of file
diff --git a/rk3588/ATK_DLRK3588/preinstall/preinstall.mk b/rk3588/ATK_DLRK3588/preinstall/preinstall.mk
index a27832a..1ba48d6 100644
--- a/rk3588/ATK_DLRK3588/preinstall/preinstall.mk
+++ b/rk3588/ATK_DLRK3588/preinstall/preinstall.mk
@@ -1 +1,2 @@
 PRODUCT_PACKAGES += TencentAppStore
+PRODUCT_PACKAGES += Auto
