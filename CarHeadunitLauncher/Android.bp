android_app {
    name: "CarHeadunitLauncher",

    srcs: ["src/**/*.java"],

    resource_dirs: ["res"],

    platform_apis: true,

    privileged: true,
    system_ext_specific: true,

    overrides: ["Launcher3QuickStep"],
}