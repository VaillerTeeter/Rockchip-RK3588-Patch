<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarLauncher" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Show the system wallpaper window (ImageWallpaper) behind the
             launcher. The wallpaper window is composed independently of
             this activity's surface, so wallpaper changes can never show
             a stale frame. -->
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
