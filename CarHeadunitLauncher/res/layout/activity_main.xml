<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e">

    <!-- 地图 + 侧边栏区域，占满剩余高度 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧地图占位 -->
        <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="#000000" />

        <!-- 右侧 app 侧边栏 (320dp, 接近手机竖屏宽) -->
        <FrameLayout
            android:id="@+id/panel_sidebar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#1e1e30">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:text="App侧边栏"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:padding="8dp" />
        </FrameLayout>

    </LinearLayout>

    <!-- 快捷入口卡片，一行横向 -->
    <LinearLayout
        android:id="@+id/shortcuts_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/card_0"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/card_0_bg" />

        <FrameLayout
            android:id="@+id/card_1"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/card_1_bg" />

        <FrameLayout
            android:id="@+id/card_2"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/card_2_bg" />

        <FrameLayout
            android:id="@+id/card_3"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/card_3_bg" />

    </LinearLayout>


</LinearLayout>
